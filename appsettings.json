{
  // Общие настройки для всех режимов. Отличия — в appsettings.{Development|Test|Production}.json,
  // режим задаёт ASPNETCORE_ENVIRONMENT (локально — Development из launchSettings.json).
  // Секреты на сервере лучше задавать переменными окружения, они перекрывают файлы:
  //   ConnectionStrings__DefaultConnection, AppSettings__secretKey и т. п.
  "AppSettings": {
    // ЕСИ (Тундук): адреса общие, redirectUrl — в файле режима.
    "clientId": "new-reestr-prod",
    "secretKey": "GMju15eIstLRTnNUz0j52BoNAUe0Rd1s",
    "authorizeUrl": "https://esia.tunduk.kg/connect/authorize",
    "tokenUrl": "https://esia.tunduk.kg/connect/token",
    "userInfoUrl": "https://esia.tunduk.kg/connect/userinfo",
    "minJustApi": "http://192.168.88.4:8080/GetSubjectByQueryRequest/getSubjectByQueryRequest"
  },
  "MinJust": {
    // Real — запросы в API Минюста, Emulator — данные генерируются по ИНН (без сети).
    "Mode": "Real",
    "TimeoutSeconds": 10,
    "CacheMinutes": 10
  },
  "Features": {
    // Кнопка «Тестовый вход» (вход без ЕСИ, организация из эмулятора Минюста).
    "EsiTestLogin": false
  },
  "Hosting": {
    // За обратным прокси (nginx): брать схему и IP клиента из X-Forwarded-*.
    "ForwardedHeaders": true,
    // Редирект на https внутри контейнера не нужен — TLS завершает прокси.
    "HttpsRedirection": false
  },
  "Logging": {
    "Directory": "",
    "RetainedFileCountLimit": 90,
    "MinimumLevel": "Information",
    "Console": true
  },
  "AllowedHosts": "*"
}
