@using System.Globalization
@{
    var ctx = ViewContext.RouteData.Values["controller"]?.ToString()?.ToLowerInvariant();
    string NavClass(string ctrl) =>
        "navlink" + (string.Equals(ctx, ctrl, StringComparison.OrdinalIgnoreCase) ? " navlink-active" : "");

    bool isAuth = User.Identity?.IsAuthenticated ?? false;
    string userName = User.Identity?.Name ?? "";
    string userOrg = User.FindFirst("orgName")?.Value ?? "";
    string userInitial = !string.IsNullOrEmpty(userName) ? userName[0].ToString().ToUpper() : "?";

    string currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    string currentPath = Context.Request.Path + Context.Request.QueryString;

    // Только две поддерживаемые локали (как на основном портале DPA)
    (string code, string label)[] langs = new[]
    {
        ("ky", "KYR"),
        ("ru", "RU"),
    };
}
<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#003971" />
    <title>@ViewData["Title"] — @L["App.TitleSuffix"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="app-shell">
    <a class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-xl focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-dpa-800 focus:shadow"
       href="#main">@L["App.SkipToContent"]</a>

    <!-- Утилитарная полоса (по брендбуку основного портала DPA) -->
    <div class="app-utilbar hidden lg:block">
        <div class="app-container">
            <div class="flex h-9 items-center justify-between">
                <!-- Слева: a11y → официальный сервис -->
                <div class="flex items-center gap-4">
                    <button type="button" id="a11yToggle"
                            class="inline-flex items-center gap-1.5 rounded-md px-2 py-0.5 hover:bg-white/10 transition"
                            aria-pressed="false" title="@L["Util.A11y"]">
                        <i class="bi bi-eye-fill"></i>
                        <span>@L["Util.A11y"]</span>
                    </button>
                    <span class="hidden xl:inline-flex items-center gap-1.5">
                        <i class="bi bi-patch-check-fill text-cyan-300"></i>
                        <span class="font-semibold uppercase tracking-wider">@L["Util.Official"]</span>
                    </span>
                </div>
                <!-- Справа: телефон, email, локали -->
                <div class="flex items-center gap-4">
                    <a href="tel:+996312902121" class="inline-flex items-center gap-1.5 hover:underline">
                        <i class="bi bi-telephone-fill"></i>
                        <span>@L["Home.Contacts.Phone"]</span>
                    </a>
                    <a href="mailto:info@dpa.gov.kg" class="inline-flex items-center gap-1.5 hover:underline">
                        <i class="bi bi-envelope-fill"></i>
                        <span>@L["Home.Contacts.Email"]</span>
                    </a>
                    <ul class="nav-locale flex items-center gap-0">
                        @foreach (var (code, label) in langs)
                        {
                            <li class="nav-locale-item">
                                <form asp-controller="Language" asp-action="Set" method="post" asp-route-returnUrl="@currentPath" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="culture" value="@code" />
                                    <button type="submit" class="nav-locale-btn @(code == currentCulture ? "is-active" : "")">@label</button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <header class="app-header">
        <div class="app-container">
            <div class="flex h-16 items-center gap-3">
                <a class="flex items-center gap-3" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="dpa-brand-mark">
                        <img src="~/img/dpa-logo.png" alt="DPA" width="44" height="44" />
                    </span>
                    <div class="leading-tight">
                        <div class="text-sm font-extrabold text-dpa-800">@L["App.Name"]</div>
                        <div class="text-[11px] uppercase tracking-wider text-dpaGray-500">@L["App.Subtitle"]</div>
                    </div>
                </a>

                <nav class="ml-4 hidden items-center gap-1 lg:flex" aria-label="@L["Nav.Home"]">
                    <a class="@NavClass("home")" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door" aria-hidden="true"></i> @L["Nav.Home"]
                    </a>
                    @if (isAuth)
                    {
                        <a class="@NavClass("incedents")" asp-area="" asp-controller="Incedents" asp-action="Index">
                            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @L["Nav.MyIncidents"]
                        </a>
                    }
                    <!-- CTA «Зарегистрировать инцидент» виден всегда. Если гость — auth-middleware перебросит на ЕСИ. -->
                    <a class="btn-register ml-2 btn-register-pulse" asp-controller="Incedents" asp-action="Create">
                        <i class="bi bi-plus-circle-fill" aria-hidden="true"></i>
                        <span>@L["Nav.RegisterIncident"]</span>
                    </a>
                </nav>

                <div class="ml-auto flex items-center gap-2">
                    <button id="navToggle"
                            class="inline-flex items-center justify-center rounded-xl border border-dpaGray-200 bg-white p-2 text-dpaGray-700 shadow-sm hover:bg-dpaGray-50 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-dpaGray-200 lg:hidden"
                            type="button" aria-controls="mobileNav" aria-expanded="false" aria-label="@L["App.OpenMenu"]">
                        <i class="bi bi-list text-xl" aria-hidden="true"></i>
                    </button>

                    @if (isAuth)
                    {
                        <div id="userDropdownWrap" class="relative hidden lg:block">
                            <button id="userDropdownBtn" type="button"
                                    class="flex items-center gap-2 rounded-xl border border-dpaGray-200 bg-white px-2 py-1.5 shadow-sm transition hover:border-dpa-300 hover:bg-dpa-50 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-dpa-200"
                                    aria-haspopup="true" aria-expanded="false">
                                <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-dpa-800 text-sm font-extrabold text-white">@userInitial</span>
                                <span class="flex flex-col items-start leading-tight">
                                    <span class="max-w-[160px] truncate text-sm font-semibold text-dpa-800">@userName</span>
                                    @if (!string.IsNullOrEmpty(userOrg))
                                    {
                                        <span class="max-w-[160px] truncate text-[11px] text-dpaGray-500">@userOrg</span>
                                    }
                                </span>
                                <i class="bi bi-chevron-down text-xs text-dpaGray-500"></i>
                            </button>

                            <div id="userDropdownMenu"
                                 class="invisible absolute right-0 z-50 mt-2 w-64 origin-top-right scale-95 rounded-2xl border border-dpaGray-200 bg-white p-2 opacity-0 shadow-lg transition"
                                 role="menu">
                                <div class="mb-1 border-b border-dpaGray-100 px-3 py-2">
                                    <div class="truncate text-sm font-semibold text-dpa-800">@userName</div>
                                    <div class="truncate text-xs text-dpaGray-500">@(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value)</div>
                                    @if (!string.IsNullOrEmpty(userOrg))
                                    {
                                        <div class="mt-1 flex items-center gap-1 text-[11px] text-dpaGray-500">
                                            <i class="bi bi-building"></i>
                                            <span class="truncate">@userOrg</span>
                                        </div>
                                    }
                                </div>
                                <a class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-dpaGray-700 hover:bg-dpa-50 hover:text-dpa-800"
                                   asp-controller="UserPage" asp-action="Index">
                                    <i class="bi bi-person-vcard"></i> @L["Nav.Profile"]
                                </a>
                                <a class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-dpaGray-700 hover:bg-dpa-50 hover:text-dpa-800"
                                   asp-controller="Incedents" asp-action="Index">
                                    <i class="bi bi-collection"></i> @L["Nav.MyIncidents"]
                                </a>
                                <div class="my-1 border-t border-dpaGray-100"></div>
                                <a class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-rose-600 hover:bg-rose-50"
                                   asp-controller="esi" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right"></i> @L["Nav.Logout"]
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="hidden items-center gap-2 lg:flex">
                            <a class="btn-secondary" href='@Url.Action("Login", "esi", new { returnUrl = currentPath })'>
                                <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> @L["Nav.LoginEsi"]
                            </a>
                            <a class="btn-test" href='@Url.Action("LoginTest", "esi", new { returnUrl = currentPath })'
                               title="@L["Nav.LoginTest"]">
                                <i class="bi bi-person-gear" aria-hidden="true"></i>
                                <span>@L["Nav.LoginTest"]</span>
                                <span class="ml-1 rounded-full bg-amber-100 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wider text-amber-700">@L["Nav.DevBadge"]</span>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div id="mobileNav" class="hidden border-t border-dpaGray-200 bg-white lg:hidden">
            <div class="app-container py-3">
                <div class="grid gap-2">
                    <a class="@NavClass("home")" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> @L["Nav.Home"]</a>
                    @if (isAuth)
                    {
                        <a class="@NavClass("incedents")" asp-area="" asp-controller="Incedents" asp-action="Index"><i class="bi bi-exclamation-triangle"></i> @L["Nav.MyIncidents"]</a>
                    }
                    <a class="btn-register mt-1 w-full btn-register-pulse" asp-controller="Incedents" asp-action="Create">
                        <i class="bi bi-plus-circle-fill"></i>
                        <span>@L["Nav.RegisterIncident"]</span>
                    </a>

                    <!-- Language + a11y mobile -->
                    <div class="mt-2 flex items-center justify-between rounded-xl border border-dpaGray-200 bg-white p-2">
                        <button type="button" id="a11yToggleMob"
                                class="inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-xs font-semibold text-dpaGray-700 hover:bg-dpaGray-50">
                            <i class="bi bi-eye-fill"></i> @L["Util.A11y"]
                        </button>
                        <ul class="nav-locale flex items-center gap-0">
                            @foreach (var (code, label) in langs)
                            {
                                <li class="nav-locale-item">
                                    <form asp-controller="Language" asp-action="Set" method="post" asp-route-returnUrl="@currentPath" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="culture" value="@code" />
                                        <button type="submit" class="nav-locale-btn nav-locale-btn-light @(code == currentCulture ? "is-active" : "")">@label</button>
                                    </form>
                                </li>
                            }
                        </ul>
                    </div>

                    @if (isAuth)
                    {
                        <div class="mt-2 rounded-xl border border-dpaGray-200 bg-dpaGray-50 p-3">
                            <div class="flex items-center gap-3">
                                <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-dpa-800 text-sm font-extrabold text-white">@userInitial</span>
                                <div class="min-w-0">
                                    <div class="truncate text-sm font-semibold text-dpa-800">@userName</div>
                                    @if (!string.IsNullOrEmpty(userOrg))
                                    {
                                        <div class="truncate text-[11px] text-dpaGray-500">@userOrg</div>
                                    }
                                </div>
                            </div>
                            <div class="mt-2 grid gap-1">
                                <a class="navlink" asp-controller="UserPage" asp-action="Index"><i class="bi bi-person-vcard"></i> @L["Nav.Profile"]</a>
                                <a class="navlink text-rose-600" asp-controller="esi" asp-action="Logout"><i class="bi bi-box-arrow-right"></i> @L["Nav.Logout"]</a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <a class="btn-secondary mt-2" href='@Url.Action("Login", "esi", new { returnUrl = currentPath })'>
                            <i class="bi bi-box-arrow-in-right"></i> @L["Nav.LoginEsi"]
                        </a>
                        <a class="btn-test mt-1" href='@Url.Action("LoginTest", "esi", new { returnUrl = currentPath })'>
                            <i class="bi bi-person-gear"></i>
                            <span>@L["Nav.LoginTest"]</span>
                            <span class="ml-1 rounded-full bg-amber-100 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wider text-amber-700">@L["Nav.DevBadge"]</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </header>

    @if (TempData["SuccessMessage"] is string okMsg && !string.IsNullOrEmpty(okMsg))
    {
        <div class="app-container mt-4">
            <div class="flex items-start gap-3 rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-emerald-800">
                <i class="bi bi-check2-circle text-xl"></i>
                <div class="text-sm font-medium">@okMsg</div>
            </div>
        </div>
    }
    @if (TempData["ErrorMessage"] is string errMsg && !string.IsNullOrEmpty(errMsg))
    {
        <div class="app-container mt-4">
            <div class="flex items-start gap-3 rounded-xl border border-rose-200 bg-rose-50 p-3 text-rose-800">
                <i class="bi bi-exclamation-circle text-xl"></i>
                <div class="text-sm font-medium">@errMsg</div>
            </div>
        </div>
    }

    <div class="app-container">
        <main id="main" role="main" class="py-4 lg:py-6">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer mt-12">
        <div class="app-container">
            <div class="grid gap-8 py-10 md:grid-cols-12">
                <!-- Брендинг + краткое описание -->
                <div class="md:col-span-5">
                    <div class="flex items-center gap-3">
                        <span class="dpa-brand-mark dpa-brand-mark-light">
                            <img src="~/img/dpa-logo.png" alt="DPA" width="44" height="44" />
                        </span>
                        <div class="leading-tight">
                            <div class="text-sm font-extrabold text-white">DPA · @L["App.TitleSuffix"]</div>
                            <div class="text-[11px] uppercase tracking-wider text-white/70">@L["App.Subtitle"]</div>
                        </div>
                    </div>
                    <p class="mt-4 max-w-md text-sm leading-relaxed">@L["Footer.Agency"]</p>
                </div>

                <!-- Разделы -->
                <div class="md:col-span-3">
                    <h4>@L["Footer.Sections"]</h4>
                    <ul class="mt-3 space-y-2 text-sm">
                        <li><a asp-controller="Home" asp-action="Index">@L["Nav.Home"]</a></li>
                        @if (isAuth)
                        {
                            <li><a asp-controller="Incedents" asp-action="Index">@L["Nav.MyIncidents"]</a></li>
                        }
                        <li><a asp-controller="Incedents" asp-action="Create">@L["Nav.RegisterIncident"]</a></li>
                    </ul>
                </div>

                <!-- Контакты -->
                <div class="md:col-span-4">
                    <h4>@L["Footer.Contacts"]</h4>
                    <ul class="mt-3 space-y-2 text-sm">
                        <li class="flex items-center gap-2">
                            <i class="bi bi-telephone-fill text-white/70"></i>
                            <a href="tel:+996312902121">@L["Home.Contacts.Phone"]</a>
                        </li>
                        <li class="flex items-center gap-2">
                            <i class="bi bi-envelope-fill text-white/70"></i>
                            <a href="mailto:info@dpa.gov.kg">@L["Home.Contacts.Email"]</a>
                        </li>
                        <li class="flex items-start gap-2">
                            <i class="bi bi-geo-alt-fill mt-1 text-white/70"></i>
                            <span>@L["Home.Contacts.Address"]</span>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="flex flex-col gap-2 border-t border-white/10 py-5 text-xs text-white/70 md:flex-row md:items-center md:justify-between">
                <div>@L["Footer.Copyright"]</div>
                <div class="flex gap-4">
                    <a asp-area="" asp-controller="Home" asp-action="Privacy">@L["Footer.Privacy"]</a>
                    <a href="#">@L["Footer.Support"]</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // a11y режим — переключение до загрузки CSS, чтоб не моргало
        (function () {
            try { if (localStorage.getItem('dpa-a11y') === '1') document.documentElement.classList.add('a11y'); } catch (e) {}
        })();
    </script>
    <script>
        (function () {
            var btn = document.getElementById('navToggle');
            var nav = document.getElementById('mobileNav');
            if (btn && nav) btn.addEventListener('click', function () { nav.classList.toggle('hidden'); });

            // Toggle accessibility mode (desktop + mobile)
            var a11yButtons = [document.getElementById('a11yToggle'), document.getElementById('a11yToggleMob')].filter(Boolean);
            function syncA11y() {
                var on = document.documentElement.classList.contains('a11y');
                a11yButtons.forEach(b => b.setAttribute('aria-pressed', on ? 'true' : 'false'));
            }
            syncA11y();
            a11yButtons.forEach(b => b.addEventListener('click', function () {
                document.documentElement.classList.toggle('a11y');
                var on = document.documentElement.classList.contains('a11y');
                try { localStorage.setItem('dpa-a11y', on ? '1' : '0'); } catch (e) {}
                syncA11y();
            }));

            function bindDropdown(wrapId, btnId, menuId) {
                var wrap = document.getElementById(wrapId);
                var b = document.getElementById(btnId);
                var m = document.getElementById(menuId);
                if (!wrap || !b || !m) return;
                function show() { m.classList.remove('invisible','opacity-0','scale-95'); m.classList.add('visible','opacity-100','scale-100'); b.setAttribute('aria-expanded','true'); }
                function hide() { m.classList.add('invisible','opacity-0','scale-95'); m.classList.remove('visible','opacity-100','scale-100'); b.setAttribute('aria-expanded','false'); }
                var timer = null, hover = false;
                wrap.addEventListener('mouseenter', function(){ clearTimeout(timer); hover = true; show(); });
                wrap.addEventListener('mouseleave', function(){ hover = false; clearTimeout(timer); timer = setTimeout(function(){ if(!hover) hide(); }, 120); });
                b.addEventListener('click', function(e){ e.stopPropagation(); if (m.classList.contains('invisible')) show(); else hide(); });
                document.addEventListener('click', function(e){ if (!wrap.contains(e.target)) hide(); });
                document.addEventListener('keydown', function(e){ if (e.key === 'Escape') hide(); });
            }
            bindDropdown('userDropdownWrap','userDropdownBtn','userDropdownMenu');
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
