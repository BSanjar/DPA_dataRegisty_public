@using System.Globalization
@{
    // Текст политики на двух языках интерфейса; язык — текущая культура (ru / ky).
    var ky = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ky";
    ViewData["Title"] = ky ? "Жеке маалыматтарды иштетүү саясаты" : "Политика обработки персональных данных";
    const string Revision = "21.10.2026";
}

<article class="mx-auto max-w-3xl">
    <div class="card">
        <div class="card-body space-y-5 text-sm leading-relaxed text-dpaGray-700">
            <header>
                <div class="inline-flex items-center gap-2 rounded-full bg-dpa-50 px-3 py-1 text-[11px] font-semibold uppercase tracking-wider text-dpa-700">
                    <i class="bi bi-shield-lock" aria-hidden="true"></i> @(ky ? "Купуялык" : "Конфиденциальность")
                </div>
                <h1 class="mt-3 text-xl font-extrabold text-dpa-800 sm:text-2xl">@ViewData["Title"]</h1>
                <p class="mt-1 text-xs text-dpaGray-500">@(ky ? "Редакциясы" : "Редакция от") @Revision</p>
            </header>

            @if (ky)
            {
                <section>
                    <h2 class="text-base font-bold text-dpa-800">1. Иштетүүчү</h2>
                    <p>Кыргыз Республикасынын Министрлер Кабинетинин алдындагы Жеке маалыматтарды коргоо боюнча мамлекеттик агенттиги (мындан ары — Агенттик): Бишкек ш., Чүй пр., 265а; тел. +(996) 312 641 172; <a class="font-semibold text-dpa-700 hover:underline" href="mailto:info@dpa.gov.kg">info@dpa.gov.kg</a>.</p>
                </section>
                <section>
                    <h2 class="text-base font-bold text-dpa-800">2. Иштетүүнүн максаты жана негизи</h2>
                    <p>Маалыматтар «Жазуу ээлеринин реестри» санариптик технологиялык системасында жазуу ээлерин каттоо жана жеке маалыматтар менен болгон инциденттерди эсепке алуу үчүн гана иштетилет. Негизи — Кыргыз Республикасынын 2025-жылдын 31-июлундагы № 178 Санариптик кодекси (63-берененин 5-бөлүгү, 90-берененин 4-бөлүгү).</p>
                </section>
                <section>
                    <h2 class="text-base font-bold text-dpa-800">3. Кандай маалыматтар иштетилет</h2>
                    <ul class="list-disc space-y-1 pl-5">
                        <li><b>Бирдиктүү идентификация системасынан (БИС)</b> кирүүдө: аты-жөнү, ПИН, туулган күнү, жынысы, жарандыгы, электрондук почтасы, телефону, уюмдун ИНН жана аталышы.</li>
                        <li><b>Юстиция министрлигинин Юридикалык жактардын бирдиктүү мамлекеттик реестринен</b>: уюмдун реквизиттери (аталышы, ИНН, каттоо номери, дареги, жетекчиси).</li>
                        <li><b>Инциденттин картасына сиз киргизген маалыматтар</b>: инциденттин сүрөттөмөсү, жеке маалыматтардын категориялары жана субъекттердин болжолдуу саны, көрүлгөн чаралар.</li>
                        <li><b>Техникалык маалыматтар</b>: кирүү сеансынын жана тилдин cookie-файлдары, ошондой эле коопсуздук журналдары (IP-дарек, убакыт, аракет) — 90 күн сакталат.</li>
                    </ul>
                </section>
                <section>
                    <h2 class="text-base font-bold text-dpa-800">4. Берүү жана сактоо</h2>
                    <p>Маалыматтар үчүнчү жактарга берилбейт, Кыргыз Республикасынын мыйзамдарында каралган учурлардан тышкары. БИС жана Юстиция министрлигинин кызматтарына суроо-талаптар колдонуучуну идентификациялоо жана уюмдун реквизиттерин алуу үчүн гана жөнөтүлөт. Маалыматтар Кыргыз Республикасынын аймагындагы Агенттиктин серверлеринде сакталат.</p>
                </section>
                <section>
                    <h2 class="text-base font-bold text-dpa-800">5. Сиздин укуктарыңыз</h2>
                    <p>Сиз өзүңүз тууралуу маалыматтардын иштетилиши жөнүндө маалымат алууга, так эмес маалыматтарды тактоону, ошондой эле мыйзамсыз иштетилген маалыматтарды бөгөттөөнү же жок кылууну талап кылууга укуктуусуз. Кайрылуулар жогоруда көрсөтүлгөн байланыштар аркылуу кабыл алынат.</p>
                </section>
            }
            else
            {
                <section>
                    <h2 class="text-base font-bold text-dpa-800">1. Оператор</h2>
                    <p>Государственное агентство по защите персональных данных при Кабинете Министров Кыргызской Республики (далее — Агентство): г. Бишкек, пр. Чуй, 265а; тел. +(996) 312 641 172; <a class="font-semibold text-dpa-700 hover:underline" href="mailto:info@dpa.gov.kg">info@dpa.gov.kg</a>.</p>
                </section>
                <section>
                    <h2 class="text-base font-bold text-dpa-800">2. Цель и основание обработки</h2>
                    <p>Данные обрабатываются только для ведения реестра владельцев записей и учёта инцидентов с персональными данными в цифровой технологической системе «Реестр владельцев записей». Основание — Цифровой кодекс Кыргызской Республики от 31 июля 2025 года № 178 (ч. 5 ст. 63, ч. 4 ст. 90).</p>
                </section>
                <section>
                    <h2 class="text-base font-bold text-dpa-800">3. Какие данные обрабатываются</h2>
                    <ul class="list-disc space-y-1 pl-5">
                        <li><b>Из Единой системы идентификации (ЕСИ)</b> при входе: ФИО, ПИН, дата рождения, пол, гражданство, адрес электронной почты, телефон, ИНН и наименование организации.</li>
                        <li><b>Из Единого государственного реестра юридических лиц Министерства юстиции</b>: реквизиты организации (наименование, ИНН, регистрационный номер, адрес, руководитель).</li>
                        <li><b>Сведения, которые вы вносите в карточку инцидента</b>: описание инцидента, категории персональных данных и примерное число субъектов, принятые меры.</li>
                        <li><b>Технические данные</b>: cookie-файлы сеанса входа и выбранного языка, а также журналы безопасности (IP-адрес, время, действие) — хранятся 90 дней.</li>
                    </ul>
                </section>
                <section>
                    <h2 class="text-base font-bold text-dpa-800">4. Передача и хранение</h2>
                    <p>Данные не передаются третьим лицам, кроме случаев, предусмотренных законодательством Кыргызской Республики. Запросы в ЕСИ и сервис Министерства юстиции направляются только для идентификации пользователя и получения реквизитов организации. Данные хранятся на серверах Агентства на территории Кыргызской Республики.</p>
                </section>
                <section>
                    <h2 class="text-base font-bold text-dpa-800">5. Ваши права</h2>
                    <p>Вы вправе получить сведения об обработке ваших данных, потребовать уточнения неточных данных, а также блокирования или удаления данных, обрабатываемых незаконно. Обращения принимаются по контактам, указанным выше.</p>
                </section>
            }
        </div>
    </div>
</article>
