@model data_registry_public.Models.local_models.DashboardViewModel
@{
    ViewData["Title"] = L["Home.Title"].Value;

    string J(string? s) => System.Text.Json.JsonSerializer.Serialize(s ?? "");
    string IntArr(IEnumerable<int> xs) => "[" + string.Join(",", xs) + "]";
    string StrArr(IEnumerable<string> xs) => "[" + string.Join(",", xs.Select(x => System.Text.Json.JsonSerializer.Serialize(x))) + "]";
}

<!-- ===== Hero + фильтры ===== -->
<section class="dpa-hero mb-4 overflow-hidden rounded-2xl shadow-sm animate-fade-up">
    <div class="relative px-5 py-5 sm:px-8 sm:py-6">
        <!-- декоративная сетка -->
        <div class="pointer-events-none absolute inset-0 opacity-25"
             style="background-image: radial-gradient(rgba(255,255,255,.25) 1px, transparent 1px); background-size: 18px 18px;"></div>

        <div class="relative grid gap-4 lg:grid-cols-12 lg:items-end">
            <div class="lg:col-span-5 xl:col-span-6">
                <div class="inline-flex items-center gap-1 rounded-full bg-white/15 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-white/90">
                    <i class="bi bi-speedometer2"></i> @L["Home.Badge"]
                </div>
                <h1 class="mt-2 text-2xl font-extrabold text-white sm:text-3xl">@L["Home.Title"]</h1>
                <p class="mt-1 max-w-xl text-sm text-white/80">@L["Home.Subtitle"]</p>
            </div>

            <!-- Фильтры -->
            <form method="get" class="relative grid gap-2 sm:grid-cols-3 lg:col-span-7 xl:col-span-6 lg:grid-cols-4">
                <div class="field">
                    <label class="form-label !text-white/80">@L["Home.Filters.Period"]</label>
                    <select name="period" class="form-control !bg-white/95">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.Period))">@L["Common.AllTime"]</option>
                        <option value="7" selected="@(Model.Period=="7")">@L["Home.Filters.Period7"]</option>
                        <option value="30" selected="@(Model.Period=="30")">@L["Home.Filters.Period30"]</option>
                        <option value="90" selected="@(Model.Period=="90")">@L["Home.Filters.Period90"]</option>
                        <option value="year" selected="@(Model.Period=="year")">@L["Home.Filters.PeriodYear"]</option>
                    </select>
                </div>
                <div class="field">
                    <label class="form-label !text-white/80">@L["Home.Filters.Severity"]</label>
                    <select name="severity" class="form-control !bg-white/95">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.Severity))">@L["Common.All"]</option>
                        <option value="Low" selected="@(Model.Severity=="Low")">@L["Severity.Low"]</option>
                        <option value="Medium" selected="@(Model.Severity=="Medium")">@L["Severity.Medium"]</option>
                        <option value="High" selected="@(Model.Severity=="High")">@L["Severity.High"]</option>
                        <option value="Critical" selected="@(Model.Severity=="Critical")">@L["Severity.Critical"]</option>
                    </select>
                </div>
                <div class="field">
                    <label class="form-label !text-white/80">@L["Home.Filters.Sector"]</label>
                    <select name="sector" class="form-control !bg-white/95">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.Sector))">@L["Common.All"]</option>
                        @foreach (var code in new[] { "IT","FIN","EDU","HLTH","CONS","TRD","LOG","AGRO","MFG","TEL","ENER","TOUR","REAL","SERV","GOV","MEDIA","INS","BANK","AUTO","FOOD","OTHER" })
                        {
                            <option value="@code" selected="@(Model.Sector==code)">@L["Sector." + code]</option>
                        }
                    </select>
                </div>
                <div class="flex gap-2 self-end">
                    <button type="submit" class="btn-accent flex-1"><i class="bi bi-funnel"></i> @L["Common.Apply"]</button>
                    <a class="btn-secondary" asp-action="Index" title="@L["Common.Reset"]"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>
</section>

<!-- ===== KPI ===== -->
<div class="mb-4 grid gap-3 grid-cols-2 md:grid-cols-3 xl:grid-cols-6 animate-fade-up delay-1">
    <div class="kpi kpi-blue">
        <div class="kpi-icon"><i class="bi bi-stack"></i></div>
        <div class="kpi-body">
            <div class="kpi-label">@L["Home.Kpi.TotalAll"]</div>
            <div class="kpi-value"><span class="count-up" data-target="@Model.TotalAll">0</span></div>
        </div>
    </div>
    <div class="kpi kpi-cyan">
        <div class="kpi-icon"><i class="bi bi-filter-circle"></i></div>
        <div class="kpi-body">
            <div class="kpi-label">@L["Home.Kpi.TotalFiltered"]</div>
            <div class="kpi-value"><span class="count-up" data-target="@Model.TotalInPeriod">0</span></div>
        </div>
    </div>
    <div class="kpi kpi-red">
        <div class="kpi-icon"><i class="bi bi-shield-exclamation"></i></div>
        <div class="kpi-body">
            <div class="kpi-label">@L["Home.Kpi.Critical"]</div>
            <div class="kpi-value">
                <span class="count-up" data-target="@Model.CriticalCount">0</span>
                <span class="ml-1 text-xs font-semibold text-rose-600">· @Model.CriticalPct.ToString("0.#",System.Globalization.CultureInfo.InvariantCulture)%</span>
            </div>
        </div>
    </div>
    <div class="kpi kpi-amber">
        <div class="kpi-icon"><i class="bi bi-globe"></i></div>
        <div class="kpi-body">
            <div class="kpi-label">@L["Home.Kpi.Published"]</div>
            <div class="kpi-value"><span class="count-up" data-target="@Model.PublishedCount">0</span></div>
        </div>
    </div>
    <div class="kpi kpi-green">
        <div class="kpi-icon"><i class="bi bi-send-check"></i></div>
        <div class="kpi-body">
            <div class="kpi-label">@L["Home.Kpi.Notified"]</div>
            <div class="kpi-value">
                <span class="count-up" data-target="@Model.NotifiedCount">0</span>
                <span class="ml-1 text-xs font-semibold text-emerald-700">· @Model.NotifiedPct.ToString("0.#",System.Globalization.CultureInfo.InvariantCulture)%</span>
            </div>
        </div>
    </div>
    <div class="kpi kpi-blue">
        <div class="kpi-icon"><i class="bi bi-database"></i></div>
        <div class="kpi-body">
            <div class="kpi-label">@L["Home.Kpi.AffectedRecords"]</div>
            <div class="kpi-value"><span class="count-up" data-target="@Model.AffectedRecordsSum">0</span></div>
        </div>
    </div>
</div>

<!-- ===== Графики ===== -->
<div class="mb-4 grid gap-4 lg:grid-cols-12">

    <!-- Тренд за 12 месяцев -->
    <div class="card animate-fade-up delay-2 lg:col-span-8">
        <div class="card-header flex items-center justify-between">
            <div>
                <div class="text-base font-extrabold text-dpa-800">@L["Home.Chart.MonthlyTitle"]</div>
                <div class="text-xs text-dpaGray-500">@L["Home.Chart.MonthlySub"]</div>
            </div>
            <div class="hidden items-center gap-3 text-xs sm:flex">
                <span class="inline-flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-full bg-dpa-600"></span> @L["Home.Chart.LegendAll"]</span>
                <span class="inline-flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-full bg-rose-500"></span> @L["Home.Chart.LegendCritical"]</span>
            </div>
        </div>
        <div class="card-body">
            <div class="chart-holder h-72"><canvas id="chartMonthly"></canvas></div>
        </div>
    </div>

    <!-- Доля по критичности -->
    <div class="card animate-fade-up delay-2 lg:col-span-4">
        <div class="card-header">
            <div class="text-base font-extrabold text-dpa-800">@L["Home.Chart.SeverityTitle"]</div>
            <div class="text-xs text-dpaGray-500">@L["Home.Chart.SeveritySub"]</div>
        </div>
        <div class="card-body">
            <div class="chart-holder h-72 relative">
                <canvas id="chartSeverity"></canvas>
                <div class="chart-center">
                    <div class="text-[11px] uppercase tracking-wider text-dpaGray-500">@L["Home.Chart.CenterTotal"]</div>
                    <div class="text-3xl font-extrabold text-dpa-800">@Model.TotalInPeriod</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card animate-fade-up delay-3 lg:col-span-6">
        <div class="card-header">
            <div class="text-base font-extrabold text-dpa-800">@L["Home.Chart.SystemsTitle"]</div>
            <div class="text-xs text-dpaGray-500">@L["Home.Chart.SystemsSub"]</div>
        </div>
        <div class="card-body">
            <div class="chart-holder h-64"><canvas id="chartSystems"></canvas></div>
        </div>
    </div>

    <div class="card animate-fade-up delay-3 lg:col-span-3">
        <div class="card-header">
            <div class="text-base font-extrabold text-dpa-800">@L["Home.Chart.PdTypeTitle"]</div>
            <div class="text-xs text-dpaGray-500">@L["Home.Chart.PdTypeSub"]</div>
        </div>
        <div class="card-body">
            <div class="chart-holder h-64"><canvas id="chartPdType"></canvas></div>
        </div>
    </div>

    <div class="card animate-fade-up delay-3 lg:col-span-3">
        <div class="card-header">
            <div class="text-base font-extrabold text-dpa-800">@L["Home.Chart.SubjectsTitle"]</div>
            <div class="text-xs text-dpaGray-500">@L["Home.Chart.SubjectsSub"]</div>
        </div>
        <div class="card-body">
            <div class="chart-holder h-64"><canvas id="chartSubjects"></canvas></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        // ===== count-up анимация =====
        (function () {
            function animate(el) {
                const target = Number(el.dataset.target) || 0;
                const duration = 900;
                const start = performance.now();
                function tick(now) {
                    const p = Math.min(1, (now - start) / duration);
                    const eased = 1 - Math.pow(1 - p, 3);
                    el.textContent = Math.round(target * eased).toLocaleString(document.documentElement.lang || 'ru');
                    if (p < 1) requestAnimationFrame(tick);
                }
                requestAnimationFrame(tick);
            }
            const io = new IntersectionObserver(entries => {
                entries.forEach(e => { if (e.isIntersecting) { animate(e.target); io.unobserve(e.target); } });
            }, { threshold: 0.2 });
            document.querySelectorAll('.count-up').forEach(el => io.observe(el));
        })();

        // ===== Chart.js ======
        const brand = {
            blue700: '#004C97', blue800: '#003971', blue500: '#0077C8',
            cyan:    '#0891B2',
            rose:    '#E11D48', roseLt: 'rgba(225,29,72,.15)',
            amber:   '#F59E0B',
            emerald: '#10B981',
            slate:   '#64748B',
            grayLt:  '#E5E7EB'
        };

        Chart.defaults.font.family = 'Raleway, sans-serif';
        Chart.defaults.color = '#525E66';
        Chart.defaults.plugins.legend.labels.boxWidth = 10;
        Chart.defaults.plugins.legend.labels.boxHeight = 10;
        Chart.defaults.plugins.legend.labels.usePointStyle = true;
        Chart.defaults.plugins.tooltip.padding = 10;
        Chart.defaults.plugins.tooltip.backgroundColor = 'rgba(0, 57, 113, .95)';
        Chart.defaults.plugins.tooltip.titleColor = '#fff';
        Chart.defaults.plugins.tooltip.bodyColor = '#fff';
        Chart.defaults.plugins.tooltip.cornerRadius = 8;
        Chart.defaults.animation.duration = 900;
        Chart.defaults.animation.easing = 'easeOutQuart';

        function gradient(ctx, c1, c2) {
            const h = ctx.canvas.height || 260;
            const g = ctx.createLinearGradient(0, 0, 0, h);
            g.addColorStop(0, c1); g.addColorStop(1, c2);
            return g;
        }

        // ---- Monthly
        (function () {
            const ctx = document.getElementById('chartMonthly').getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: @Html.Raw(StrArr(Model.MonthlyLabels)),
                    datasets: [
                        {
                            label: @Html.Raw(J(L["Home.Chart.LegendAll"].Value)),
                            data: @Html.Raw(IntArr(Model.MonthlySeries)),
                            borderColor: brand.blue700,
                            backgroundColor: gradient(ctx, 'rgba(0,76,151,.35)', 'rgba(0,76,151,0)'),
                            borderWidth: 3,
                            pointRadius: 3,
                            pointHoverRadius: 6,
                            tension: 0.35,
                            fill: true
                        },
                        {
                            label: @Html.Raw(J(L["Home.Chart.LegendCritical"].Value)),
                            data: @Html.Raw(IntArr(Model.MonthlyCriticalSeries)),
                            borderColor: brand.rose,
                            backgroundColor: brand.roseLt,
                            borderWidth: 2,
                            borderDash: [6, 4],
                            pointRadius: 2,
                            tension: 0.35,
                            fill: false
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { display: false } },
                        y: { beginAtZero: true, grid: { color: brand.grayLt }, ticks: { precision: 0 } }
                    }
                }
            });
        })();

        // ---- Severity doughnut
        (function () {
            const ctx = document.getElementById('chartSeverity').getContext('2d');
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: [
                        @Html.Raw(J(L["Severity.Critical"].Value)),
                        @Html.Raw(J(L["Severity.High"].Value)),
                        @Html.Raw(J(L["Severity.Medium"].Value)),
                        @Html.Raw(J(L["Severity.Low"].Value))
                    ],
                    datasets: [{
                        data: [@Model.BySeverity["Critical"], @Model.BySeverity["High"], @Model.BySeverity["Medium"], @Model.BySeverity["Low"]],
                        backgroundColor: [brand.rose, '#F97316', brand.amber, brand.emerald],
                        borderColor: '#fff',
                        borderWidth: 2,
                        hoverOffset: 8
                    }]
                },
                options: {
                    cutout: '68%',
                    plugins: { legend: { position: 'bottom' } },
                    maintainAspectRatio: false,
                    responsive: true
                }
            });
        })();

        // ---- Systems bar
        (function () {
            const ctx = document.getElementById('chartSystems').getContext('2d');
            const rawLabels  = @Html.Raw(StrArr(Model.BySystemType.Keys));
            const sysMap = {
                db:             @Html.Raw(J(L["SystemType.Db"].Value)),
                website:        @Html.Raw(J(L["SystemType.Website"].Value)),
                infosystem:     @Html.Raw(J(L["SystemType.InfoSystemShort"].Value)),
                cloude_service: @Html.Raw(J(L["SystemType.CloudShort"].Value)),
                local_network:  @Html.Raw(J(L["SystemType.LocalNetworkShort"].Value)),
                unknown:        @Html.Raw(J(L["Common.Dash"].Value))
            };
            const niceLabels = rawLabels.map(x => sysMap[x] || x);
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: niceLabels,
                    datasets: [{
                        label: 'Инцидентов',
                        data: @Html.Raw(IntArr(Model.BySystemType.Values)),
                        backgroundColor: gradient(ctx, brand.blue500, brand.blue800),
                        borderRadius: 10,
                        borderSkipped: false,
                        maxBarThickness: 42
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { display: false } },
                        y: { beginAtZero: true, grid: { color: brand.grayLt }, ticks: { precision: 0 } }
                    }
                }
            });
        })();

        // ---- PD Type pie
        (function () {
            const ctx = document.getElementById('chartPdType').getContext('2d');
            new Chart(ctx, {
                type: 'polarArea',
                data: {
                    labels: [
                        @Html.Raw(J(L["PdType.Regular"].Value)),
                        @Html.Raw(J(L["PdType.Special"].Value)),
                        @Html.Raw(J(L["PdType.Biometric"].Value))
                    ],
                    datasets: [{
                        data: [@Model.ByPersonalDataType["Regular"], @Model.ByPersonalDataType["Special"], @Model.ByPersonalDataType["Biometric"]],
                        backgroundColor: ['rgba(0,119,200,.75)','rgba(225,29,72,.75)','rgba(16,185,129,.75)'],
                        borderColor: '#fff', borderWidth: 2
                    }]
                },
                options: {
                    plugins: { legend: { position: 'bottom' } },
                    responsive: true, maintainAspectRatio: false,
                    scales: { r: { grid: { color: brand.grayLt }, ticks: { display: false } } }
                }
            });
        })();

        // ---- Subjects
        (function () {
            const ctx = document.getElementById('chartSubjects').getContext('2d');
            const rawLabels  = @Html.Raw(StrArr(Model.BySubjectCategory.Keys));
            const subjMap = {
                Employees: @Html.Raw(J(L["SubjCat.Employees"].Value)),
                Clients:   @Html.Raw(J(L["SubjCat.Clients"].Value)),
                Citizens:  @Html.Raw(J(L["SubjCat.Citizens"].Value)),
                SiteUsers: @Html.Raw(J(L["SubjCat.SiteUsersShort"].Value)),
                Other:     @Html.Raw(J(L["SubjCat.Other"].Value))
            };
            const niceLabels = rawLabels.map(x => subjMap[x] || x);
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: niceLabels,
                    datasets: [{
                        data: @Html.Raw(IntArr(Model.BySubjectCategory.Values)),
                        backgroundColor: [brand.blue700, brand.cyan, brand.emerald, brand.amber, brand.slate, brand.rose],
                        borderColor: '#fff', borderWidth: 2, hoverOffset: 8
                    }]
                },
                options: {
                    cutout: '60%',
                    plugins: { legend: { position: 'bottom' } },
                    responsive: true, maintainAspectRatio: false
                }
            });
        })();
    </script>
}
