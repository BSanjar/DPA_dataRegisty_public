@model data_registry_public.Models.local_models.DashboardViewModel
@{
    ViewData["Title"] = L["Home.Title"].Value;

    string J(string? s) => System.Text.Json.JsonSerializer.Serialize(s ?? "");
    string IntArr(IEnumerable<int> xs) => "[" + string.Join(",", xs) + "]";
    string StrArr(IEnumerable<string> xs) => "[" + string.Join(",", xs.Select(x => System.Text.Json.JsonSerializer.Serialize(x))) + "]";

    bool isAuth = User.Identity?.IsAuthenticated ?? false;

    // Берём только последние 6 точек тренда для компактности
    var labels = Model.MonthlyLabels.TakeLast(6).ToList();
    var seriesAll = Model.MonthlySeries.TakeLast(6).ToList();
    var seriesCrit = Model.MonthlyCriticalSeries.TakeLast(6).ToList();
}

<!-- ============ HERO ============ -->
<section class="landing-hero animate-fade-up">
    <div class="landing-hero-bg" aria-hidden="true"></div>
    <div class="landing-hero-shade" aria-hidden="true"></div>

    <div class="relative px-4 py-8 sm:px-8 sm:py-12 lg:px-12 lg:py-16">
        <div class="max-w-2xl">
            <div class="inline-flex max-w-full items-center gap-2 rounded-full bg-white/15 px-3 py-1 text-[10px] font-semibold uppercase tracking-wider text-white backdrop-blur sm:text-[11px]">
                <i class="bi bi-shield-shaded"></i>
                <span class="truncate">@L["Home.Hero.Badge"]</span>
            </div>
            <h1 class="mt-3 text-[22px] font-extrabold leading-tight text-white sm:mt-4 sm:text-4xl lg:text-5xl drop-shadow-sm">
                @L["Home.Hero.Title"]
            </h1>
            <p class="mt-3 text-[13px] text-white/90 sm:mt-4 sm:text-base lg:text-lg">
                @L["Home.Hero.Subtitle"]
            </p>
            <div class="mt-5 flex flex-col gap-2 sm:mt-7 sm:flex-row sm:flex-wrap sm:items-center sm:gap-3">
                <!-- Главный CTA — всегда виден. Если гость, [Authorize] перебросит на /esi/Login. -->
                <a class="hero-btn hero-btn-primary hero-btn-pulse w-full sm:w-auto" asp-controller="Incedents" asp-action="Create">
                    <i class="bi bi-plus-circle-fill"></i> @L["Home.Hero.CtaRegister"]
                </a>
                @if (!isAuth)
                {
                    <a class="hero-btn hero-btn-ghost w-full sm:w-auto" href='@Url.Action("Login", "esi", new { returnUrl = Url.Action("Create", "Incedents") })'>
                        <i class="bi bi-box-arrow-in-right"></i> @L["Nav.LoginEsi"]
                    </a>
                }
                <a class="hero-btn hero-btn-ghost w-full sm:w-auto" href="#about">
                    <i class="bi bi-arrow-down-circle"></i> @L["Home.Hero.CtaLearn"]
                </a>
            </div>
        </div>
    </div>

    <!-- Inline mini-stats внизу hero -->
    <div class="hero-stats-bar">
        <div class="hero-stats-grid">
            <div class="hero-stat">
                <span class="hero-stat-icon"><i class="bi bi-shield-shaded"></i></span>
                <div class="hero-stat-body">
                    <span class="hero-stat-value count-up" data-target="@Model.TotalAll">0</span>
                    <span class="hero-stat-label">@L["Home.Hero.Mini.Incidents"]</span>
                </div>
            </div>
            <div class="hero-stat">
                <span class="hero-stat-icon"><i class="bi bi-calendar-event"></i></span>
                <div class="hero-stat-body">
                    <span class="hero-stat-value count-up" data-target="@Model.Last30DaysCount">0</span>
                    <span class="hero-stat-label">@L["Home.Hero.Mini.Month"]</span>
                </div>
            </div>
            <div class="hero-stat">
                <span class="hero-stat-icon"><i class="bi bi-database-fill-check"></i></span>
                <div class="hero-stat-body">
                    <span class="hero-stat-value count-up" data-target="@Model.AffectedRecordsSum">0</span>
                    <span class="hero-stat-label">@L["Home.Hero.Mini.Records"]</span>
                </div>
            </div>
            <div class="hero-stat">
                <span class="hero-stat-icon"><i class="bi bi-send-check-fill"></i></span>
                <div class="hero-stat-body">
                    <span class="hero-stat-value count-up" data-target="@Model.NotifiedCount">0</span>
                    <span class="hero-stat-label">@L["Home.Hero.Mini.Notified"]</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============ О реестре ============ -->
<section id="about" class="mt-10 sm:mt-12 animate-fade-up delay-1">
    <div class="mx-auto max-w-3xl px-2 text-center">
        <div class="inline-flex items-center gap-2 rounded-full bg-dpa-50 px-3 py-1 text-[11px] font-semibold uppercase tracking-wider text-dpa-700">
            <i class="bi bi-info-circle"></i> @L["Home.About.Badge"]
        </div>
        <h2 class="mt-3 text-xl font-extrabold text-dpa-800 sm:text-2xl lg:text-3xl">@L["Home.About.Title"]</h2>
        <p class="mt-3 text-sm text-dpaGray-600 sm:text-base">@L["Home.About.Sub"]</p>
    </div>

    <div class="mt-6 grid gap-3 sm:mt-8 sm:gap-4 md:grid-cols-3">
        <div class="info-card animate-fade-up delay-2">
            <div class="info-icon info-icon-blue"><i class="bi bi-people-fill"></i></div>
            <h3 class="info-title">@L["Home.Card1.Title"]</h3>
            <p class="info-body">@L["Home.Card1.Body"]</p>
        </div>
        <div class="info-card animate-fade-up delay-2">
            <div class="info-icon info-icon-cyan"><i class="bi bi-buildings"></i></div>
            <h3 class="info-title">@L["Home.Card2.Title"]</h3>
            <p class="info-body">@L["Home.Card2.Body"]</p>
        </div>
        <div class="info-card animate-fade-up delay-2">
            <div class="info-icon info-icon-amber"><i class="bi bi-shield-check"></i></div>
            <h3 class="info-title">@L["Home.Card3.Title"]</h3>
            <p class="info-body">@L["Home.Card3.Body"]</p>
        </div>
    </div>
</section>

<!-- ============ Как зарегистрировать (3 шага) ============ -->
<section class="mt-10 rounded-2xl bg-gradient-to-br from-dpa-50/70 via-white to-white p-4 sm:mt-14 sm:rounded-3xl sm:p-10 animate-fade-up delay-2">
    <div class="mx-auto max-w-3xl text-center">
        <div class="inline-flex items-center gap-2 rounded-full bg-white px-3 py-1 text-[11px] font-semibold uppercase tracking-wider text-dpa-700 shadow-sm">
            <i class="bi bi-stars"></i> @L["Home.HowTo.Badge"]
        </div>
        <h2 class="mt-3 text-xl font-extrabold text-dpa-800 sm:text-2xl lg:text-3xl">@L["Home.HowTo.Title"]</h2>
        <p class="mt-3 text-sm text-dpaGray-600 sm:text-base">@L["Home.HowTo.Sub"]</p>
    </div>

    <ol class="relative mt-6 grid gap-3 sm:mt-8 sm:gap-4 lg:grid-cols-3">
        <li class="howto-step animate-fade-up delay-3">
            <div class="howto-num">01</div>
            <i class="bi bi-person-badge howto-icon text-dpa-700"></i>
            <h3 class="howto-title">@L["Home.Step1.Title"]</h3>
            <p class="howto-body">@L["Home.Step1.Body"]</p>
        </li>
        <li class="howto-step animate-fade-up delay-3">
            <div class="howto-num">02</div>
            <i class="bi bi-pencil-square howto-icon text-amber-600"></i>
            <h3 class="howto-title">@L["Home.Step2.Title"]</h3>
            <p class="howto-body">@L["Home.Step2.Body"]</p>
        </li>
        <li class="howto-step animate-fade-up delay-3">
            <div class="howto-num">03</div>
            <i class="bi bi-graph-up-arrow howto-icon text-emerald-600"></i>
            <h3 class="howto-title">@L["Home.Step3.Title"]</h3>
            <p class="howto-body">@L["Home.Step3.Body"]</p>
        </li>
    </ol>

    <div class="mt-7 flex justify-center">
        <a class="btn-primary" asp-controller="Incedents" asp-action="Create">
            <i class="bi bi-plus-circle-fill"></i> @L["Home.Hero.CtaRegister"]
        </a>
    </div>
</section>

<!-- ============ Компактный график + контакты ============ -->
<section class="mt-10 grid gap-3 sm:mt-12 sm:gap-4 lg:grid-cols-12 animate-fade-up delay-3">

    <!-- Компактный тренд -->
    <div class="card lg:col-span-7">
        <div class="card-header flex flex-wrap items-center justify-between gap-3">
            <div>
                <div class="text-base font-extrabold text-dpa-800">@L["Home.Trend.Title"]</div>
                <div class="text-xs text-dpaGray-500">@L["Home.Trend.Sub"]</div>
            </div>
            <form method="get" class="flex items-center gap-2">
                <label class="text-[11px] font-semibold uppercase tracking-wider text-dpaGray-500">@L["Home.Filters.Period"]</label>
                <select name="period" onchange="this.form.submit()"
                        class="h-8 rounded-lg border border-dpaGray-200 bg-white px-2 text-xs text-dpaGray-800 shadow-sm outline-none focus:ring-2 focus:ring-dpa-200">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.Period))">@L["Common.AllTime"]</option>
                    <option value="30" selected="@(Model.Period=="30")">@L["Home.Filters.Period30"]</option>
                    <option value="90" selected="@(Model.Period=="90")">@L["Home.Filters.Period90"]</option>
                    <option value="year" selected="@(Model.Period=="year")">@L["Home.Filters.PeriodYear"]</option>
                </select>
            </form>
        </div>
        <div class="card-body">
            <div class="chart-holder h-56"><canvas id="chartMonthly"></canvas></div>
            <div class="mt-3 flex items-center justify-between text-xs text-dpaGray-500">
                <div class="flex items-center gap-3">
                    <span class="inline-flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-full bg-dpa-600"></span> @L["Home.Chart.LegendAll"]</span>
                    <span class="inline-flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-full bg-rose-500"></span> @L["Home.Chart.LegendCritical"]</span>
                </div>
                @if (isAuth)
                {
                    <a asp-controller="Incedents" asp-action="Index" class="font-semibold text-dpa-700 hover:text-dpa-800">
                        @L["Home.Trend.More"] <i class="bi bi-arrow-right"></i>
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Контакты -->
    <div class="card lg:col-span-5">
        <div class="card-header">
            <div class="inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-wider text-dpa-700">
                <i class="bi bi-headset"></i> @L["Home.Contacts.Badge"]
            </div>
            <div class="mt-1 text-base font-extrabold text-dpa-800">@L["Home.Contacts.Title"]</div>
            <div class="text-xs text-dpaGray-500">@L["Home.Contacts.Sub"]</div>
        </div>
        <div class="card-body space-y-3 text-sm">
            <div class="contact-row">
                <div class="contact-ico bg-dpa-50 text-dpa-700"><i class="bi bi-telephone-fill"></i></div>
                <div>
                    <a href="tel:+996312902121" class="font-semibold text-dpaGray-800 hover:text-dpa-800">@L["Home.Contacts.Phone"]</a>
                    <div class="text-[11px] text-dpaGray-500">@L["Home.Contacts.Hours"]</div>
                </div>
            </div>
            <div class="contact-row">
                <div class="contact-ico bg-emerald-50 text-emerald-600"><i class="bi bi-envelope-fill"></i></div>
                <div>
                    <a href="mailto:info@dpa.gov.kg" class="font-semibold text-dpaGray-800 hover:text-dpa-800">@L["Home.Contacts.Email"]</a>
                </div>
            </div>
            <div class="contact-row">
                <div class="contact-ico bg-amber-50 text-amber-700"><i class="bi bi-geo-alt-fill"></i></div>
                <div class="font-semibold text-dpaGray-800">@L["Home.Contacts.Address"]</div>
            </div>
            <a href="mailto:info@dpa.gov.kg" class="btn-secondary mt-2 w-full">
                <i class="bi bi-chat-dots"></i> @L["Home.Contacts.Cta"]
            </a>
        </div>
    </div>
</section>

<!-- ============ Нормативная база ============ -->
<section class="mt-12 mb-2 animate-fade-up delay-4">
    <div class="card">
        <div class="card-body grid gap-4 sm:grid-cols-12 sm:items-center">
            <div class="sm:col-span-4">
                <div class="inline-flex items-center gap-2 rounded-full bg-amber-50 px-3 py-1 text-[11px] font-semibold uppercase tracking-wider text-amber-700">
                    <i class="bi bi-journal-bookmark"></i> @L["Home.Laws.Badge"]
                </div>
                <h3 class="mt-2 text-lg font-extrabold text-dpa-800">@L["Home.Laws.Title"]</h3>
            </div>
            <ul class="sm:col-span-8 grid gap-2 text-sm">
                <li class="law-item"><i class="bi bi-file-earmark-text text-dpa-700"></i><span>@L["Home.Laws.Law1"]</span></li>
                <li class="law-item"><i class="bi bi-file-earmark-text text-dpa-700"></i><span>@L["Home.Laws.Law2"]</span></li>
                <li class="law-item"><i class="bi bi-file-earmark-text text-dpa-700"></i><span>@L["Home.Laws.Law3"]</span></li>
            </ul>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            function animate(el) {
                const target = Number(el.dataset.target) || 0;
                const duration = 900;
                const start = performance.now();
                function tick(now) {
                    const p = Math.min(1, (now - start) / duration);
                    const eased = 1 - Math.pow(1 - p, 3);
                    el.textContent = Math.round(target * eased).toLocaleString(document.documentElement.lang || 'ru');
                    if (p < 1) requestAnimationFrame(tick);
                }
                requestAnimationFrame(tick);
            }
            const io = new IntersectionObserver(entries => {
                entries.forEach(e => { if (e.isIntersecting) { animate(e.target); io.unobserve(e.target); } });
            }, { threshold: 0.2 });
            document.querySelectorAll('.count-up').forEach(el => io.observe(el));
        })();

        Chart.defaults.font.family = 'Raleway, sans-serif';
        Chart.defaults.color = '#525E66';
        Chart.defaults.plugins.legend.display = false;
        Chart.defaults.plugins.tooltip.padding = 10;
        Chart.defaults.plugins.tooltip.backgroundColor = 'rgba(0, 57, 113, .95)';
        Chart.defaults.plugins.tooltip.titleColor = '#fff';
        Chart.defaults.plugins.tooltip.bodyColor = '#fff';
        Chart.defaults.plugins.tooltip.cornerRadius = 8;
        Chart.defaults.animation.duration = 900;
        Chart.defaults.animation.easing = 'easeOutQuart';

        (function () {
            const ctx = document.getElementById('chartMonthly').getContext('2d');
            function gradient(c1, c2) {
                const g = ctx.createLinearGradient(0, 0, 0, ctx.canvas.height || 220);
                g.addColorStop(0, c1); g.addColorStop(1, c2); return g;
            }
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: @Html.Raw(StrArr(labels)),
                    datasets: [
                        {
                            label: @Html.Raw(J(L["Home.Chart.LegendAll"].Value)),
                            data: @Html.Raw(IntArr(seriesAll)),
                            borderColor: '#004C97',
                            backgroundColor: gradient('rgba(0,76,151,.35)', 'rgba(0,76,151,0)'),
                            borderWidth: 3, pointRadius: 3, pointHoverRadius: 6, tension: 0.4, fill: true
                        },
                        {
                            label: @Html.Raw(J(L["Home.Chart.LegendCritical"].Value)),
                            data: @Html.Raw(IntArr(seriesCrit)),
                            borderColor: '#E11D48',
                            backgroundColor: 'rgba(225,29,72,.12)',
                            borderWidth: 2, borderDash: [6, 4], pointRadius: 2, tension: 0.4, fill: false
                        }
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    scales: {
                        x: { grid: { display: false } },
                        y: { beginAtZero: true, grid: { color: '#E5E7EB' }, ticks: { precision: 0 } }
                    }
                }
            });
        })();
    </script>
}
