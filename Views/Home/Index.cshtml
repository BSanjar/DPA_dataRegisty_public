@{
    ViewData["Title"] = "Обзор";
}

<div class="grid gap-4 lg:grid-cols-12 lg:gap-6">
    <section class="card lg:col-span-7">
        <div class="card-body">
            <div class="mb-4 inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-900 shadow-sm dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100">
                <i class="bi bi-shield-lock text-blue-600 dark:text-blue-400" aria-hidden="true"></i>
                <span>АИС «Реестр владельцев записей»</span>
            </div>

            <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Учёт инцидентов, проверок и ответственности</h1>
            <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-300">
                Единое пространство для фиксации событий с персональными данными, контроля соблюдения законодательства и ведения материалов по привлечению к ответственности.
            </p>

            <div class="mt-6 flex flex-col gap-2 sm:flex-row">
                <a class="btn-primary" href="#"><i class="bi bi-plus-lg" aria-hidden="true"></i> Создать запись</a>
                <a class="btn-secondary" href="#"><i class="bi bi-search" aria-hidden="true"></i> Найти</a>
            </div>
        </div>
    </section>

    <aside class="card lg:col-span-5">
        <div class="card-header">
            <div class="flex items-center justify-between">
                <div class="font-semibold">Быстрый доступ</div>
                <div class="text-xs text-slate-500 dark:text-slate-400">Шаблоны разделов</div>
            </div>
        </div>
        <div class="card-body">
            <div class="grid gap-2">
                <a class="navlink border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900" asp-area="" asp-controller="Incedents" asp-action="Index">
                    <i class="bi bi-exclamation-triangle text-amber-500" aria-hidden="true"></i>
                    <div class="leading-tight">
                        <div class="font-semibold text-slate-900 dark:text-slate-100">Инциденты</div>
                        <div class="text-xs text-slate-500 dark:text-slate-400">Фиксация и сопровождение</div>
                    </div>
                </a>
                <a class="navlink border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900" asp-area="" asp-controller="Inspections" asp-action="Index">
                    <i class="bi bi-clipboard-check text-emerald-500" aria-hidden="true"></i>
                    <div class="leading-tight">
                        <div class="font-semibold text-slate-900 dark:text-slate-100">Проверки</div>
                        <div class="text-xs text-slate-500 dark:text-slate-400">План / внеплан, итоги</div>
                    </div>
                </a>
                <a class="navlink border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900" asp-area="" asp-controller="Sanctions" asp-action="Index">
                    <i class="bi bi-journal-text text-blue-600 dark:text-blue-400" aria-hidden="true"></i>
                    <div class="leading-tight">
                        <div class="font-semibold text-slate-900 dark:text-slate-100">Протоколы</div>
                        <div class="text-xs text-slate-500 dark:text-slate-400">Привлечение к ответственности</div>
                    </div>
                </a>
            </div>
        </div>
    </aside>
</div>
