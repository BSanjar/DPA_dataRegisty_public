@model IEnumerable<data_registry_public.Models.Incident>
@{
    ViewData["Title"] = "Инциденты";
    var org = ViewBag.CurrentOrg as data_registry_public.Integrations.MinJustOrganizationInfo;
    string? q = ViewBag.FilterQuery as string;
    string? sev = ViewBag.FilterSeverity as string;
    string? per = ViewBag.FilterPeriod as string;
    int totalOwn = (int)(ViewBag.TotalOwn ?? 0);
    string? highlightId = TempData.Peek("HighlightIncidentId") as string;
    TempData.Remove("HighlightIncidentId");
}

<!-- Компактная шапка + KPI в одной строке -->
<div class="mb-4 grid gap-3 lg:grid-cols-12 lg:items-stretch">
    <!-- Заголовок (узкий) -->
    <section class="dpa-hero rounded-xl px-4 py-3 shadow-sm lg:col-span-4 xl:col-span-3">
        <div class="flex items-center justify-between gap-3">
            <div class="min-w-0">
                <div class="inline-flex items-center gap-1 rounded-full bg-white/15 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-white/90">
                    <i class="bi bi-shield-exclamation"></i> Учёт инцидентов
                </div>
                <h1 class="mt-1 truncate text-lg font-extrabold text-white">Мои инциденты</h1>
            </div>
            <a class="btn-accent btn-sm shrink-0" asp-action="Create">
                <i class="bi bi-plus-lg"></i> Добавить
            </a>
        </div>
    </section>

    <!-- KPI: 4 красочных узких блока -->
    <div class="grid grid-cols-2 gap-3 md:grid-cols-4 lg:col-span-8 xl:col-span-9">
        <div class="kpi kpi-blue">
            <div class="kpi-icon"><i class="bi bi-stack"></i></div>
            <div class="kpi-body">
                <div class="kpi-label">Всего</div>
                <div class="kpi-value">@totalOwn</div>
            </div>
        </div>
        <div class="kpi kpi-red">
            <div class="kpi-icon"><i class="bi bi-shield-exclamation"></i></div>
            <div class="kpi-body">
                <div class="kpi-label">Критичные</div>
                <div class="kpi-value">@Model.Count(i => i.Incidentseverity == "Critical" || i.Incidentseverity == "High")</div>
            </div>
        </div>
        <div class="kpi kpi-cyan">
            <div class="kpi-icon"><i class="bi bi-calendar3"></i></div>
            <div class="kpi-body">
                <div class="kpi-label">За 30 дней</div>
                <div class="kpi-value">@Model.Count(i => i.DateCreate >= DateTime.Now.AddDays(-30))</div>
            </div>
        </div>
        <div class="kpi kpi-green">
            <div class="kpi-icon"><i class="bi bi-send-check"></i></div>
            <div class="kpi-body">
                <div class="kpi-label">Уведомлены</div>
                <div class="kpi-value">@Model.Count(i => i.Aresubjectsnotified == true)</div>
            </div>
        </div>
    </div>
</div>

<!-- Узкая карточка организации -->
@if (org != null && !string.IsNullOrEmpty(org.Tin))
{
    <div class="mb-4 flex flex-wrap items-center gap-3 rounded-xl border border-dpaGray-200 bg-white px-4 py-2 shadow-sm">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-dpa-50 text-dpa-800">
            <i class="bi bi-building"></i>
        </div>
        <div class="min-w-0 flex-1">
            <div class="truncate text-sm font-semibold text-dpa-800">@org.FullName</div>
            <div class="truncate text-xs text-dpaGray-500">
                ИНН @org.Tin
                @if (!string.IsNullOrEmpty(org.BusinessSectorName)) { <span>· @org.BusinessSectorName</span> }
                @if (!string.IsNullOrEmpty(org.Address)) { <span>· @org.Address</span> }
            </div>
        </div>
        <span class="badge badge-success"><i class="bi bi-check2-circle"></i> Минюст</span>
    </div>
}

<!-- Журнал -->
<div class="card">
    <div class="card-header">
        <form method="get" class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
            <div class="flex flex-wrap items-end gap-3">
                <div class="field min-w-[220px] flex-1">
                    <label class="form-label">Поиск</label>
                    <div class="relative">
                        <i class="bi bi-search pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-dpaGray-400"></i>
                        <input name="q" value="@q" type="search" placeholder="Номер, описание, место…"
                               class="form-control pl-10" />
                    </div>
                </div>
                <div class="field w-44">
                    <label class="form-label">Критичность</label>
                    <select name="severity" class="form-control">
                        <option value="">все</option>
                        <option value="Low" selected="@(sev=="Low")">Низкий</option>
                        <option value="Medium" selected="@(sev=="Medium")">Средний</option>
                        <option value="High" selected="@(sev=="High")">Высокий</option>
                        <option value="Critical" selected="@(sev=="Critical")">Критический</option>
                    </select>
                </div>
                <div class="field w-40">
                    <label class="form-label">Период</label>
                    <select name="period" class="form-control">
                        <option value="">всё время</option>
                        <option value="7" selected="@(per=="7")">7 дней</option>
                        <option value="30" selected="@(per=="30")">30 дней</option>
                        <option value="90" selected="@(per=="90")">90 дней</option>
                        <option value="year" selected="@(per=="year")">год</option>
                    </select>
                </div>
            </div>
            <div class="flex gap-2">
                <button type="submit" class="btn-primary"><i class="bi bi-funnel"></i> Применить</button>
                <a class="btn-secondary" asp-action="Index"><i class="bi bi-arrow-counterclockwise"></i> Сбросить</a>
            </div>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="card-body">
            <div class="rounded-2xl border border-dashed border-dpaGray-300 p-10 text-center">
                <div class="mx-auto mb-3 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-dpa-50 text-dpa-700">
                    <i class="bi bi-inbox text-2xl"></i>
                </div>
                <div class="text-base font-extrabold text-dpa-800">
                    @(totalOwn == 0 ? "У вас пока нет инцидентов" : "По заданным фильтрам ничего не найдено")
                </div>
                <div class="mt-1 text-sm text-dpaGray-500">
                    @(totalOwn == 0
                        ? "Зарегистрируйте первый инцидент с персональными данными за 3 шага."
                        : "Попробуйте изменить условия поиска или сбросить фильтры.")
                </div>
                @if (totalOwn == 0)
                {
                    <a class="btn-primary mt-4" asp-action="Create">
                        <i class="bi bi-plus-lg"></i> Зарегистрировать инцидент
                    </a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="dpa-table">
                <thead>
                    <tr>
                        <th>№ / Дата</th>
                        <th>Описание</th>
                        <th>Критичность</th>
                        <th>Затронуто записей</th>
                        <th>Уведомление</th>
                        <th class="text-right">Действия</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    string sevKind = item.Incidentseverity switch
                    {
                        "Critical" => "badge-danger",
                        "High" => "badge-danger",
                        "Medium" => "badge-warning",
                        "Low" => "badge-success",
                        _ => "badge-neutral"
                    };
                    string sevText = item.Incidentseverity switch
                    {
                        "Critical" => "Критический",
                        "High" => "Высокий",
                        "Medium" => "Средний",
                        "Low" => "Низкий",
                        _ => "—"
                    };
                    bool isNew = highlightId == item.Id;
                    <tr class="@(isNew ? "bg-emerald-50/60" : "")">
                        <td>
                            <div class="font-mono text-xs font-semibold text-dpa-800">@item.IncidentRegnumber</div>
                            <div class="text-xs text-dpaGray-500">@item.DateCreate?.ToString("dd.MM.yyyy HH:mm")</div>
                            @if (isNew)
                            {
                                <div class="mt-1 inline-flex items-center gap-1 rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-bold uppercase text-emerald-700">
                                    <i class="bi bi-stars"></i> новый
                                </div>
                            }
                        </td>
                        <td>
                            <div class="line-clamp-2 max-w-md text-dpaGray-800">@item.IncidentDescription</div>
                            @if (!string.IsNullOrEmpty(item.IncidetLocation))
                            {
                                <div class="mt-1 inline-flex items-center gap-1 text-xs text-dpaGray-500">
                                    <i class="bi bi-geo-alt"></i> @item.IncidetLocation
                                </div>
                            }
                        </td>
                        <td>
                            <span class="badge @sevKind">@sevText</span>
                        </td>
                        <td>
                            <div class="font-semibold text-dpaGray-800">@(item.Affectedrecordscount?.ToString("N0") ?? "—")</div>
                            @if (item.Isdatapublished == true)
                            {
                                <div class="mt-1 text-xs text-rose-600"><i class="bi bi-globe"></i> опубликованы</div>
                            }
                            else if (item.Isdatacopiedorstolen == true)
                            {
                                <div class="mt-1 text-xs text-amber-600"><i class="bi bi-clipboard-x"></i> скопированы</div>
                            }
                        </td>
                        <td>
                            @if (item.Aresubjectsnotified == true)
                            {
                                <span class="inline-flex items-center gap-1 text-emerald-600"><i class="bi bi-check2-circle"></i> отправлено</span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1 text-dpaGray-500"><i class="bi bi-dash-circle"></i> нет</span>
                            }
                        </td>
                        <td class="text-right">
                            <a class="btn-secondary btn-sm" asp-action="Details" asp-route-id="@item.Id">
                                <i class="bi bi-eye"></i> Открыть
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
