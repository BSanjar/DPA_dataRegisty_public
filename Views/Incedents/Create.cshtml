@model data_registry_public.Models.local_models.IncidentCreateViewModel
@{
    ViewData["Title"] = L["Create.Title"].Value;
    var org = ViewBag.CurrentOrg as data_registry_public.Integrations.MinJustOrganizationInfo;
}

<div class="mb-6 flex flex-col gap-2">
    <a class="inline-flex w-fit items-center gap-1 text-sm text-dpaGray-500 hover:text-dpa-800" asp-action="Index">
        <i class="bi bi-arrow-left"></i> @L["Common.BackToList"]
    </a>
    <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
            <div class="text-[11px] font-semibold uppercase tracking-wider text-dpa-500">@L["Create.Breadcrumb"]</div>
            <h1 class="mt-1 text-2xl font-extrabold tracking-tight text-dpa-800 sm:text-3xl">@L["Create.Title"]</h1>
            <p class="mt-1 text-sm text-dpaGray-500">@L["Create.Subtitle"]</p>
        </div>
    </div>
</div>

<!-- Stepper -->
<ol id="wizSteps" class="stepper mb-6">
    <li class="step is-active" data-step="1">
        <div class="step-num">1</div>
        <div><div class="step-sub">@L["Create.Step1"]</div><div class="step-title">@L["Create.Step1.Title"]</div></div>
    </li>
    <li class="step" data-step="2">
        <div class="step-num">2</div>
        <div><div class="step-sub">@L["Create.Step2"]</div><div class="step-title">@L["Create.Step2.Title"]</div></div>
    </li>
    <li class="step" data-step="3">
        <div class="step-num">3</div>
        <div><div class="step-sub">@L["Create.Step3"]</div><div class="step-title">@L["Create.Step3.Title"]</div></div>
    </li>
</ol>

@if (!ViewData.ModelState.IsValid)
{
    <div class="mb-4 flex items-start gap-3 rounded-xl border border-rose-200 bg-rose-50 p-3 text-rose-800">
        <i class="bi bi-exclamation-triangle-fill mt-0.5"></i>
        <div class="text-sm font-medium">@L["Create.ServerErrorsHeading"]</div>
    </div>
}

<form id="wizForm" asp-action="Save" method="post" class="relative space-y-6" novalidate>
    @Html.AntiForgeryToken()

    <!-- Оверлей, блокирующий форму во время регистрации -->
    <div id="wizOverlay" class="wiz-overlay" aria-hidden="true">
        <div class="wiz-overlay-box">
            <div class="wiz-spinner" aria-hidden="true">
                <svg viewBox="0 0 50 50" class="wiz-spinner-svg">
                    <circle class="wiz-spinner-track" cx="25" cy="25" r="20" fill="none" stroke-width="5"></circle>
                    <circle class="wiz-spinner-head"  cx="25" cy="25" r="20" fill="none" stroke-width="5"></circle>
                </svg>
            </div>
            <div class="mt-4 text-base font-extrabold text-dpa-800">@L["Create.Overlay.Title"]</div>
            <div class="mt-1 text-sm text-dpaGray-500">@L["Create.Overlay.Sub"]</div>
            <div class="mt-4 flex items-center gap-1 text-xs text-dpaGray-400">
                <span class="wiz-dot"></span><span class="wiz-dot"></span><span class="wiz-dot"></span>
            </div>
        </div>
    </div>

    <!-- ========== STEP 1: Organization (read-only) ========== -->
    <section class="wiz-pane card" data-pane="1">
        <div class="card-header flex flex-wrap items-center justify-between gap-2">
            <div>
                <div class="text-base font-extrabold text-dpa-800">@L["Create.Step1.Title"]</div>
                <div class="text-xs text-dpaGray-500">@L["Create.Step1.Header.Sub"]</div>
            </div>
            <span class="badge badge-success"><i class="bi bi-check2-circle"></i> @L["Create.Step1.Badge"]</span>
        </div>

        @if (org == null)
        {
            <div class="card-body">
                <div class="rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-700">
                    <i class="bi bi-exclamation-circle"></i>
                    @L["Create.Org.NotFound"]
                </div>
            </div>
        }
        else
        {
            <div class="card-body">
                <div class="flex items-start gap-3">
                    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-dpa-800 text-white">
                        <i class="bi bi-building"></i>
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="text-base font-extrabold text-dpa-800">@org.FullName</div>
                        <div class="text-xs text-dpaGray-500">
                            ИНН @org.Tin · @org.LegalForm · @org.BusinessSectorName
                        </div>
                    </div>
                </div>

                <dl class="mt-4 grid gap-x-6 gap-y-3 text-sm sm:grid-cols-2 lg:grid-cols-3">
                    <div class="field">
                        <dt class="form-label">@L["Create.Org.RegNumber"]</dt>
                        <dd class="text-dpaGray-800">@org.RegistrationNumber</dd>
                    </div>
                    <div class="field">
                        <dt class="form-label">@L["Create.Org.RegDate"]</dt>
                        <dd class="text-dpaGray-800">@org.RegistrationDate</dd>
                    </div>
                    <div class="field">
                        <dt class="form-label">@L["Create.Org.Status"]</dt>
                        <dd class="text-dpaGray-800"><span class="badge badge-success">@org.Status</span></dd>
                    </div>
                    <div class="field lg:col-span-2">
                        <dt class="form-label">@L["Create.Org.Address"]</dt>
                        <dd class="text-dpaGray-800">@org.Address</dd>
                    </div>
                    <div class="field">
                        <dt class="form-label">@L["Create.Org.Director"]</dt>
                        <dd class="text-dpaGray-800">
                            @org.DirectorName
                            @if (!string.IsNullOrEmpty(org.DirectorPosition))
                            {
                                <span class="text-dpaGray-500"> · @org.DirectorPosition</span>
                            }
                        </dd>
                    </div>
                </dl>
            </div>
        }

        <div class="card-body flex justify-between border-t border-dpaGray-200">
            <a class="btn-secondary" asp-action="Index"><i class="bi bi-x-lg"></i> @L["Common.Cancel"]</a>
            <button type="button" class="btn-primary" data-next="2" @(org == null ? "disabled" : "")>
                @L["Common.Next"] <i class="bi bi-arrow-right"></i>
            </button>
        </div>
    </section>

    <!-- ========== STEP 2: Incident info ========== -->
    <section class="wiz-pane card hidden" data-pane="2" data-validate-pane>
        <div class="card-header">
            <div class="text-base font-extrabold text-dpa-800">@L["Create.Step2.Header.Title"]</div>
            <div class="text-xs text-dpaGray-500">@L["Create.Step2.Header.Sub"]</div>
        </div>
        <div class="card-body space-y-5">

            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                <div class="field">
                    <label asp-for="DateOccurrence" class="form-label">@L["Create.Label.DateOccurrence"] <span class="text-rose-600">*</span></label>
                    <input asp-for="DateOccurrence" type="datetime-local" class="form-control" data-required="true" data-validate="datetime-past" />
                    <span class="field-error" asp-validation-for="DateOccurrence"></span>
                </div>
                <div class="field">
                    <label asp-for="DateDetection" class="form-label">@L["Create.Label.DateDetection"] <span class="text-rose-600">*</span></label>
                    <input asp-for="DateDetection" type="datetime-local" class="form-control" data-required="true" data-validate="datetime-after-occurrence" />
                    <span class="field-error" asp-validation-for="DateDetection"></span>
                </div>
                <div class="field">
                    <label asp-for="IncidentType" class="form-label">@L["Create.Label.IncidentType"] <span class="text-rose-600">*</span></label>
                    <select asp-for="IncidentType" class="form-control" data-required="true">
                        <option value="">@L["Common.Choose"]</option>
                        <option value="Unauthorized access">@L["IncType.Unauthorized"]</option>
                        <option value="Data leak">@L["IncType.Leak"]</option>
                        <option value="Data loss">@L["IncType.Loss"]</option>
                        <option value="Data destruction">@L["IncType.Destruction"]</option>
                        <option value="Phishing">@L["IncType.Phishing"]</option>
                        <option value="Malware">@L["IncType.Malware"]</option>
                        <option value="Insider">@L["IncType.Insider"]</option>
                        <option value="Other">@L["IncType.Other"]</option>
                    </select>
                    <span class="field-error" asp-validation-for="IncidentType"></span>
                </div>
                <div class="field">
                    <label asp-for="IncidentSeverity" class="form-label">@L["Create.Label.Severity"] <span class="text-rose-600">*</span></label>
                    <select asp-for="IncidentSeverity" class="form-control" data-required="true">
                        <option value="">@L["Common.Choose"]</option>
                        <option value="Low">@L["Severity.Low"]</option>
                        <option value="Medium">@L["Severity.Medium"]</option>
                        <option value="High">@L["Severity.High"]</option>
                        <option value="Critical">@L["Severity.Critical"]</option>
                    </select>
                    <span class="field-error" asp-validation-for="IncidentSeverity"></span>
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                <div class="field">
                    <label asp-for="IncidentLocation" class="form-label">@L["Create.Label.Location"] <span class="text-rose-600">*</span></label>
                    <input asp-for="IncidentLocation" class="form-control" data-required="true" maxlength="255"
                           placeholder="@L["Create.PH.Location"]" />
                    <span class="field-error" asp-validation-for="IncidentLocation"></span>
                </div>
                <div class="field">
                    <label asp-for="AffectedInformationSystem" class="form-label">@L["Create.Label.AffectedSystem"] <span class="text-rose-600">*</span></label>
                    <input asp-for="AffectedInformationSystem" class="form-control" data-required="true" maxlength="255"
                           placeholder="@L["Create.PH.AffectedSystem"]" />
                    <span class="field-error" asp-validation-for="AffectedInformationSystem"></span>
                </div>
                <div class="field">
                    <label asp-for="SystemType" class="form-label">@L["Create.Label.SystemType"] <span class="text-rose-600">*</span></label>
                    <select asp-for="SystemType" class="form-control" data-required="true">
                        <option value="">@L["Common.Choose"]</option>
                        <option value="db">@L["SystemType.Db"]</option>
                        <option value="website">@L["SystemType.Website"]</option>
                        <option value="infosystem">@L["SystemType.InfoSystem"]</option>
                        <option value="cloude_service">@L["SystemType.Cloud"]</option>
                        <option value="local_network">@L["SystemType.LocalNetwork"]</option>
                    </select>
                    <span class="field-error" asp-validation-for="SystemType"></span>
                </div>
            </div>

            <div class="field">
                <label asp-for="IncidentDescription" class="form-label">
                    @L["Create.Label.Description"] <span class="text-rose-600">*</span>
                    <span class="char-counter" data-counter-for="IncidentDescription">0 / 4000</span>
                </label>
                <textarea asp-for="IncidentDescription" rows="3" class="form-control"
                          data-required="true" data-min-length="10" maxlength="4000"
                          placeholder="@L["Create.PH.Description"]"></textarea>
                <span class="field-error" asp-validation-for="IncidentDescription"></span>
            </div>

            <div class="field">
                <label asp-for="SuspectedCause" class="form-label">@L["Create.Label.SuspectedCause"]</label>
                <textarea asp-for="SuspectedCause" rows="2" class="form-control" maxlength="2000"
                          placeholder="@L["Create.PH.Cause"]"></textarea>
                <span class="field-error" asp-validation-for="SuspectedCause"></span>
            </div>
        </div>
        <div class="card-body flex justify-between border-t border-dpaGray-200">
            <button type="button" class="btn-secondary" data-prev="1"><i class="bi bi-arrow-left"></i> @L["Common.Back"]</button>
            <button type="button" class="btn-primary" data-next="3">@L["Common.Next"] <i class="bi bi-arrow-right"></i></button>
        </div>
    </section>

    <!-- ========== STEP 3: Data & actions ========== -->
    <section class="wiz-pane card hidden" data-pane="3" data-validate-pane>
        <div class="card-header">
            <div class="text-base font-extrabold text-dpa-800">@L["Create.Step3.Header.Title"]</div>
            <div class="text-xs text-dpaGray-500">@L["Create.Step3.Header.Sub"]</div>
        </div>
        <div class="card-body space-y-5">

            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                <div class="field">
                    <label asp-for="AffectedRecordsCount" class="form-label">@L["Create.Label.Records"] <span class="text-rose-600">*</span></label>
                    <input asp-for="AffectedRecordsCount" type="number" min="0" step="1" class="form-control"
                           data-required="true" data-validate="integer-nonneg" inputmode="numeric"
                           placeholder="0" />
                    <span class="field-error" asp-validation-for="AffectedRecordsCount"></span>
                </div>
                <div class="field">
                    <label asp-for="EstimatedDataSubjectsCount" class="form-label">@L["Create.Label.Subjects"] <span class="text-rose-600">*</span></label>
                    <input asp-for="EstimatedDataSubjectsCount" class="form-control"
                           data-required="true" data-validate="digits-only" inputmode="numeric" maxlength="10"
                           placeholder="1500" />
                    <span class="field-error" asp-validation-for="EstimatedDataSubjectsCount"></span>
                </div>
                <div class="field">
                    <label asp-for="PersonalDataType" class="form-label">@L["Create.Label.PdType"] <span class="text-rose-600">*</span></label>
                    <select asp-for="PersonalDataType" class="form-control" data-required="true">
                        <option value="">@L["Common.Choose"]</option>
                        <option value="Regular">@L["PdType.Regular"]</option>
                        <option value="Special">@L["PdType.Special"]</option>
                        <option value="Biometric">@L["PdType.Biometric"]</option>
                    </select>
                    <span class="field-error" asp-validation-for="PersonalDataType"></span>
                </div>
                <div class="field">
                    <label asp-for="DataSubjectCategory" class="form-label">@L["Create.Label.SubjectCategory"] <span class="text-rose-600">*</span></label>
                    <select asp-for="DataSubjectCategory" class="form-control" data-required="true">
                        <option value="">@L["Common.Choose"]</option>
                        <option value="Employees">@L["SubjCat.Employees"]</option>
                        <option value="Clients">@L["SubjCat.Clients"]</option>
                        <option value="Citizens">@L["SubjCat.Citizens"]</option>
                        <option value="SiteUsers">@L["SubjCat.SiteUsers"]</option>
                        <option value="Other">@L["SubjCat.Other"]</option>
                    </select>
                    <span class="field-error" asp-validation-for="DataSubjectCategory"></span>
                </div>
            </div>

            <div class="field">
                <label asp-for="PersonalDataCategories" class="form-label">@L["Create.Label.PdCategories"] <span class="text-rose-600">*</span></label>
                <input asp-for="PersonalDataCategories" class="form-control" data-required="true" maxlength="500"
                       placeholder="@L["Create.PH.PdCategories"]" />
                <span class="field-error" asp-validation-for="PersonalDataCategories"></span>
            </div>

            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                <label class="check-card">
                    <input asp-for="IsDataCopiedOrStolen" type="checkbox" />
                    <div>
                        <div class="text-sm font-semibold">@L["Create.Label.IsCopied"]</div>
                        <div class="text-xs text-dpaGray-500">@L["Create.Note.IsCopied"]</div>
                    </div>
                </label>
                <label class="check-card">
                    <input asp-for="IsDataPublished" type="checkbox" />
                    <div>
                        <div class="text-sm font-semibold">@L["Create.Label.IsPublished"]</div>
                        <div class="text-xs text-dpaGray-500">@L["Create.Note.IsPublished"]</div>
                    </div>
                </label>
                <label class="check-card">
                    <input asp-for="HasRiskOfHarmToSubjects" type="checkbox" />
                    <div>
                        <div class="text-sm font-semibold">@L["Create.Label.HasRisk"]</div>
                        <div class="text-xs text-dpaGray-500">@L["Create.Note.HasRisk"]</div>
                    </div>
                </label>
                <label class="check-card">
                    <input asp-for="AreSubjectsNotified" type="checkbox" id="AreSubjectsNotifiedChk" />
                    <div>
                        <div class="text-sm font-semibold">@L["Create.Label.Notified"]</div>
                        <div class="text-xs text-dpaGray-500">@L["Create.Note.Notified"]</div>
                    </div>
                </label>
            </div>

            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                <div class="field">
                    <label asp-for="NotificationSentAt" class="form-label">@L["Create.Label.NotifSentAt"]</label>
                    <input asp-for="NotificationSentAt" type="datetime-local" class="form-control"
                           data-required-if="#AreSubjectsNotifiedChk" />
                    <span class="field-error" asp-validation-for="NotificationSentAt"></span>
                </div>
            </div>

            <div class="grid gap-4 lg:grid-cols-3">
                <div class="field">
                    <label asp-for="ActionsTaken" class="form-label">@L["Create.Label.ActionsTaken"] <span class="text-rose-600">*</span></label>
                    <textarea asp-for="ActionsTaken" rows="3" class="form-control"
                              data-required="true" data-min-length="5" maxlength="2000"
                              placeholder="@L["Create.PH.ActionsTaken"]"></textarea>
                    <span class="field-error" asp-validation-for="ActionsTaken"></span>
                </div>
                <div class="field">
                    <label asp-for="PreventionMeasures" class="form-label">@L["Create.Label.Prevention"]</label>
                    <textarea asp-for="PreventionMeasures" rows="3" class="form-control" maxlength="2000"
                              placeholder="@L["Create.PH.Prevention"]"></textarea>
                    <span class="field-error" asp-validation-for="PreventionMeasures"></span>
                </div>
                <div class="field">
                    <label asp-for="InvestigationInfo" class="form-label">@L["Create.Label.Investigation"]</label>
                    <textarea asp-for="InvestigationInfo" rows="3" class="form-control" maxlength="2000"
                              placeholder="@L["Create.PH.Investigation"]"></textarea>
                    <span class="field-error" asp-validation-for="InvestigationInfo"></span>
                </div>
            </div>
        </div>
        <div class="card-body flex flex-col gap-3 border-t border-dpaGray-200 sm:flex-row sm:justify-between">
            <button type="button" class="btn-secondary" data-prev="2"><i class="bi bi-arrow-left"></i> @L["Common.Back"]</button>
            <button type="submit" id="submitBtn" class="btn-primary">
                <i class="bi bi-check2-circle"></i> @L["Create.Btn.Register"]
            </button>
        </div>
    </section>
</form>

@section Scripts {
    <script>
    (function () {
        const steps = Array.from(document.querySelectorAll('#wizSteps .step'));
        const panes = Array.from(document.querySelectorAll('.wiz-pane'));
        const form  = document.getElementById('wizForm');

        // ===== helpers =====
        function isEmpty(v) { return v === null || v === undefined || String(v).trim() === ''; }

        function setError(el, message) {
            el.classList.add('is-invalid');
            el.classList.remove('is-valid');
            const err = el.parentElement.querySelector('.field-error');
            if (err) { err.textContent = message; err.classList.add('visible'); }
        }
        function clearError(el) {
            el.classList.remove('is-invalid');
            const err = el.parentElement.querySelector('.field-error');
            if (err) { err.textContent = ''; err.classList.remove('visible'); }
        }

        // ===== input masks =====
        document.querySelectorAll('[data-validate="digits-only"]').forEach(input => {
            input.addEventListener('input', () => {
                const cleaned = input.value.replace(/\D+/g, '');
                if (cleaned !== input.value) input.value = cleaned;
            });
            input.addEventListener('paste', e => {
                e.preventDefault();
                const text = (e.clipboardData || window.clipboardData).getData('text').replace(/\D+/g, '');
                document.execCommand('insertText', false, text);
            });
        });
        document.querySelectorAll('[data-validate="integer-nonneg"]').forEach(input => {
            input.addEventListener('input', () => {
                if (input.value && Number(input.value) < 0) input.value = '0';
                const cleaned = input.value.replace(/[^\d]/g, '');
                if (cleaned !== input.value) input.value = cleaned;
            });
        });

        // Счётчик символов для textarea с maxlength
        document.querySelectorAll('.char-counter').forEach(c => {
            const name = c.dataset.counterFor;
            const field = form.querySelector(`[name="${name}"]`);
            if (!field) return;
            const max = field.getAttribute('maxlength') || '∞';
            const update = () => { c.textContent = `${field.value.length} / ${max}`; };
            field.addEventListener('input', update);
            update();
        });

        // ===== validation of a single field =====
        function validateField(el) {
            if (el.tagName === 'INPUT' && el.type === 'hidden') return true;
            const required = el.dataset.required === 'true';
            const validate = el.dataset.validate;
            const minLen   = el.dataset.minLength ? Number(el.dataset.minLength) : 0;
            const requiredIf = el.dataset.requiredIf;
            const val = el.value;

            // required-if: поле обязательно только если checkbox отмечен
            if (!required && requiredIf) {
                const target = document.querySelector(requiredIf);
                if (target && target.checked && isEmpty(val)) {
                    setError(el, 'Укажите дату отправки уведомления');
                    return false;
                }
            }

            if (required && isEmpty(val)) {
                setError(el, 'Поле обязательно для заполнения');
                return false;
            }

            if (!isEmpty(val)) {
                if (validate === 'digits-only' && !/^\d+$/.test(val)) {
                    setError(el, 'Только цифры'); return false;
                }
                if (validate === 'integer-nonneg') {
                    const n = Number(val);
                    if (!Number.isFinite(n) || n < 0 || !Number.isInteger(n)) {
                        setError(el, 'Целое число ≥ 0'); return false;
                    }
                }
                if (minLen > 0 && val.trim().length < minLen) {
                    setError(el, `Минимум ${minLen} символов`); return false;
                }
                if (validate === 'datetime-past') {
                    if (new Date(val) > new Date()) {
                        setError(el, 'Дата не может быть в будущем'); return false;
                    }
                }
                if (validate === 'datetime-after-occurrence') {
                    const occ = form.querySelector('[name="DateOccurrence"]')?.value;
                    if (occ && new Date(val) < new Date(occ)) {
                        setError(el, 'Дата обнаружения не может быть раньше даты возникновения');
                        return false;
                    }
                    if (new Date(val) > new Date()) {
                        setError(el, 'Дата не может быть в будущем'); return false;
                    }
                }
            }

            clearError(el);
            return true;
        }

        // ===== validate all fields of a pane =====
        function validatePane(paneNum) {
            const pane = document.querySelector(`.wiz-pane[data-pane="${paneNum}"][data-validate-pane]`);
            if (!pane) return true;
            const fields = pane.querySelectorAll('[data-required], [data-validate], [data-min-length], [data-required-if]');
            let allOk = true;
            let firstInvalid = null;
            fields.forEach(el => {
                const ok = validateField(el);
                if (!ok && !firstInvalid) firstInvalid = el;
                allOk = allOk && ok;
            });
            if (!allOk && firstInvalid) {
                firstInvalid.focus({ preventScroll: true });
                firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
            return allOk;
        }

        // live-валидация при blur и при изменении
        form.querySelectorAll('[data-required], [data-validate], [data-min-length], [data-required-if]').forEach(el => {
            el.addEventListener('blur',   () => validateField(el));
            el.addEventListener('change', () => validateField(el));
            if (el.tagName === 'TEXTAREA' || el.type === 'text' || el.type === 'number') {
                el.addEventListener('input', () => {
                    if (el.classList.contains('is-invalid')) validateField(el);
                });
            }
        });

        // если checkbox "субъекты уведомлены" меняется — пересчитываем валидность NotificationSentAt
        const notifiedChk = document.getElementById('AreSubjectsNotifiedChk');
        if (notifiedChk) {
            notifiedChk.addEventListener('change', () => {
                const dt = form.querySelector('[name="NotificationSentAt"]');
                if (dt) validateField(dt);
            });
        }

        // ===== step navigation =====
        function showStep(n) {
            panes.forEach(p => p.classList.toggle('hidden', p.dataset.pane !== String(n)));
            steps.forEach(s => {
                const num = Number(s.dataset.step);
                s.classList.remove('is-active', 'is-done');
                if (num < n) s.classList.add('is-done');
                else if (num === n) s.classList.add('is-active');
            });
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        document.querySelectorAll('[data-next]').forEach(btn => {
            btn.addEventListener('click', () => {
                const current = Array.from(panes).find(p => !p.classList.contains('hidden'))?.dataset.pane;
                if (current && !validatePane(Number(current))) {
                    return; // не пускаем дальше
                }
                showStep(Number(btn.dataset.next));
            });
        });
        document.querySelectorAll('[data-prev]').forEach(btn => {
            btn.addEventListener('click', () => showStep(Number(btn.dataset.prev)));
        });

        // ===== финальный submit =====
        const overlay = document.getElementById('wizOverlay');
        const submitBtn = document.getElementById('submitBtn');

        function showSubmittingState() {
            // Оверлей сам по себе блокирует взаимодействие (pointer-events: auto).
            // НЕЛЬЗЯ disable'ить инпуты — тогда они не отправятся в POST,
            // включая __RequestVerificationToken, и сервер вернёт 400.
            if (overlay) {
                overlay.classList.add('is-active');
                overlay.setAttribute('aria-hidden', 'false');
            }
            if (submitBtn) {
                submitBtn.setAttribute('aria-busy', 'true');
                submitBtn.classList.add('pointer-events-none', 'opacity-80');
                submitBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> ' + @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Create.Btn.Submitting"].Value));
            }
        }

        let submitted = false;
        form.addEventListener('submit', e => {
            if (submitted) { e.preventDefault(); return; } // защита от двойного submit
            const ok2 = validatePane(2);
            const ok3 = validatePane(3);
            if (!ok2 || !ok3) {
                e.preventDefault();
                if (!ok2) showStep(2);
                else if (!ok3) showStep(3);
                return;
            }
            submitted = true;
            showSubmittingState();
        });

        // Защита от «back/forward cache» — при возврате сбрасываем overlay
        window.addEventListener('pageshow', () => {
            submitted = false;
            if (overlay) {
                overlay.classList.remove('is-active');
                overlay.setAttribute('aria-hidden', 'true');
            }
            if (submitBtn) {
                submitBtn.removeAttribute('aria-busy');
                submitBtn.classList.remove('pointer-events-none', 'opacity-80');
                submitBtn.innerHTML = '<i class="bi bi-check2-circle"></i> ' + @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Create.Btn.Register"].Value));
            }
        });

        // Если сервер вернул ошибки валидации — подсветим инпуты с server-side error
        document.querySelectorAll('.field-error').forEach(span => {
            if (span.textContent && span.textContent.trim().length > 0) {
                span.classList.add('visible');
                const control = span.parentElement.querySelector('input, select, textarea');
                if (control) control.classList.add('is-invalid');
            }
        });
    })();
    </script>
}
