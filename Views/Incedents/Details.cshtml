@model data_registry_public.Models.Incident
@{
    ViewData["Title"] = "Инцидент " + (Model.IncidentRegnumber ?? "");
    string Sev(string? s) => s switch
    {
        "Critical" => "Критический",
        "High" => "Высокий",
        "Medium" => "Средний",
        "Low" => "Низкий",
        _ => "—"
    };
    string SevBadge(string? s) => s switch
    {
        "Critical" => "badge badge-danger",
        "High" => "badge badge-danger",
        "Medium" => "badge badge-warning",
        "Low" => "badge badge-success",
        _ => "badge badge-neutral"
    };
    string TypeLabel(string? t) => t switch
    {
        "db" => "База данных",
        "website" => "Веб-сайт",
        "infosystem" => "Информационная система",
        "cloude_service" => "Облачный сервис",
        "local_network" => "Локальная сеть",
        _ => t ?? "—"
    };
}

<div class="mb-6">
    <a class="inline-flex items-center gap-1 text-sm text-dpaGray-500 hover:text-dpa-800" asp-action="Index">
        <i class="bi bi-arrow-left"></i> Назад к списку
    </a>
</div>

<div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <div class="font-mono text-[11px] font-semibold uppercase tracking-wider text-dpa-500">@Model.IncidentRegnumber</div>
        <h1 class="mt-1 text-2xl font-extrabold text-dpa-800 sm:text-3xl">Карточка инцидента</h1>
        <div class="mt-1 text-sm text-dpaGray-500">
            Зарегистрирован @Model.DateCreate?.ToString("dd.MM.yyyy HH:mm")
        </div>
    </div>
    <span class="@SevBadge(Model.Incidentseverity)">
        <i class="bi bi-shield-exclamation"></i> @Sev(Model.Incidentseverity)
    </span>
</div>

<div class="grid gap-4 lg:grid-cols-3">
    <div class="space-y-4 lg:col-span-2">
        <div class="card">
            <div class="card-header"><div class="text-base font-extrabold text-dpa-800">Описание</div></div>
            <div class="card-body">
                <p class="whitespace-pre-wrap text-dpaGray-800">
                    @(string.IsNullOrWhiteSpace(Model.IncidentDescription) ? "—" : Model.IncidentDescription)
                </p>
                @if (!string.IsNullOrEmpty(Model.Suspectedincidentcause))
                {
                    <div class="mt-4 rounded-xl border border-dpaGray-200 bg-dpaGray-50 p-3 text-sm">
                        <div class="form-label">Предполагаемая причина</div>
                        <div class="whitespace-pre-wrap text-dpaGray-800">@Model.Suspectedincidentcause</div>
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header"><div class="text-base font-extrabold text-dpa-800">Принятые меры</div></div>
            <div class="card-body grid gap-4 sm:grid-cols-2">
                <div>
                    <div class="form-label">Устранение</div>
                    <div class="mt-1 whitespace-pre-wrap text-sm text-dpaGray-800">
                        @(string.IsNullOrWhiteSpace(Model.Actionstaken) ? "—" : Model.Actionstaken)
                    </div>
                </div>
                <div>
                    <div class="form-label">Профилактика</div>
                    <div class="mt-1 whitespace-pre-wrap text-sm text-dpaGray-800">
                        @(string.IsNullOrWhiteSpace(Model.Preventionmeasures) ? "—" : Model.Preventionmeasures)
                    </div>
                </div>
                <div class="sm:col-span-2">
                    <div class="form-label">Внутреннее расследование</div>
                    <div class="mt-1 whitespace-pre-wrap text-sm text-dpaGray-800">
                        @(string.IsNullOrWhiteSpace(Model.Investigationinfo) ? "—" : Model.Investigationinfo)
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><div class="text-base font-extrabold text-dpa-800">Затронутые данные</div></div>
            <div class="card-body grid gap-4 sm:grid-cols-3">
                <div>
                    <div class="form-label">Записей</div>
                    <div class="mt-1 text-2xl font-extrabold text-dpa-800">@(Model.Affectedrecordscount?.ToString("N0") ?? "—")</div>
                </div>
                <div>
                    <div class="form-label">Субъектов</div>
                    <div class="mt-1 text-2xl font-extrabold text-dpa-800">
                        @(string.IsNullOrEmpty(Model.Estimateddatasubjectscount) ? "—" : Model.Estimateddatasubjectscount)
                    </div>
                </div>
                <div>
                    <div class="form-label">Тип данных</div>
                    <div class="mt-1 text-sm font-semibold text-dpaGray-800">
                        @(Model.Personaldatatype switch
                        {
                            "Regular" => "Обычные",
                            "Special" => "Специальные",
                            "Biometric" => "Биометрические",
                            _ => "—"
                        })
                    </div>
                </div>
                <div class="sm:col-span-3">
                    <div class="form-label">Категории данных</div>
                    <div class="mt-1 text-sm text-dpaGray-800">
                        @(string.IsNullOrEmpty(Model.Personaldatacategories) ? "—" : Model.Personaldatacategories)
                    </div>
                </div>
                <div class="sm:col-span-3 flex flex-wrap gap-2">
                    @if (Model.Isdatacopiedorstolen == true) { <span class="badge badge-warning"><i class="bi bi-clipboard-x"></i> Скопированы/похищены</span> }
                    @if (Model.Isdatapublished == true)     { <span class="badge badge-danger"><i class="bi bi-globe"></i> Опубликованы</span> }
                    @if (Model.Hasriskofharmtosubjects==true){ <span class="badge badge-warning"><i class="bi bi-exclamation-triangle"></i> Риск вреда</span> }
                    @if (Model.Aresubjectsnotified == true) { <span class="badge badge-success"><i class="bi bi-send-check"></i> Субъекты уведомлены</span> }
                </div>
            </div>
        </div>
    </div>

    <div class="space-y-4">
        <div class="card">
            <div class="card-header"><div class="text-base font-extrabold text-dpa-800">Хронология</div></div>
            <div class="card-body space-y-3 text-sm">
                <div class="flex items-start gap-3">
                    <div class="mt-0.5 flex h-7 w-7 items-center justify-center rounded-full bg-dpaGray-100 text-dpaGray-600"><i class="bi bi-clock"></i></div>
                    <div>
                        <div class="form-label">Произошёл</div>
                        <div class="font-medium text-dpaGray-800">@(Model.DateOccurrence?.ToString("dd.MM.yyyy HH:mm") ?? "—")</div>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <div class="mt-0.5 flex h-7 w-7 items-center justify-center rounded-full bg-amber-100 text-amber-700"><i class="bi bi-eye"></i></div>
                    <div>
                        <div class="form-label">Обнаружен</div>
                        <div class="font-medium text-dpaGray-800">@(Model.DateDetection?.ToString("dd.MM.yyyy HH:mm") ?? "—")</div>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <div class="mt-0.5 flex h-7 w-7 items-center justify-center rounded-full bg-dpa-100 text-dpa-800"><i class="bi bi-journal-plus"></i></div>
                    <div>
                        <div class="form-label">Зарегистрирован</div>
                        <div class="font-medium text-dpaGray-800">@(Model.DateCreate?.ToString("dd.MM.yyyy HH:mm") ?? "—")</div>
                    </div>
                </div>
                @if (Model.Notificationsentat.HasValue)
                {
                    <div class="flex items-start gap-3">
                        <div class="mt-0.5 flex h-7 w-7 items-center justify-center rounded-full bg-emerald-100 text-emerald-700"><i class="bi bi-send"></i></div>
                        <div>
                            <div class="form-label">Уведомление направлено</div>
                            <div class="font-medium text-dpaGray-800">@Model.Notificationsentat?.ToString("dd.MM.yyyy HH:mm")</div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header"><div class="text-base font-extrabold text-dpa-800">Система</div></div>
            <div class="card-body space-y-2 text-sm">
                <div>
                    <div class="form-label">Место возникновения</div>
                    <div class="font-medium text-dpaGray-800">@(string.IsNullOrEmpty(Model.IncidetLocation) ? "—" : Model.IncidetLocation)</div>
                </div>
                <div>
                    <div class="form-label">Затронутая система</div>
                    <div class="font-medium text-dpaGray-800">@(string.IsNullOrEmpty(Model.Affectedinformationsystem) ? "—" : Model.Affectedinformationsystem)</div>
                </div>
                <div>
                    <div class="form-label">Тип системы</div>
                    <div class="font-medium text-dpaGray-800">@TypeLabel(Model.Systemtype)</div>
                </div>
            </div>
        </div>
    </div>
</div>
